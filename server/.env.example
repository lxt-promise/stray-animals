# ---- 服务鉴权（与云函数 AI_TOKEN 保持一致）----
API_TOKEN=change-me-please

# ---- 模型设备：auto / cpu / cuda ----
DEVICE=auto

# ---- ReID 骨干：动物个体识别专用预训练模型（无需自己训练）----
# ONNX 优先（推荐）。留空则退回 torch/timm 在线加载；两者都不可用则走内置哈希占位引擎
REID_ONNX=
REID_SIZE=518
# torch 模式下的权重来源
REID_TORCH=timm/vit_large_patch14_dinov2.lvd142m

# ---- 猫体检测：YOLO ONNX；留空则不检测、直接整图提特征 ----
DETECT_ONNX=
DETECT_CONF=0.35

# ---- 是否需要毛色/花纹属性（CLIP 零样本分类，关闭可省 ~600MB 显存）----
USE_CLIP=0
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# ---- 特征库持久化 ----
INDEX_DB=/data/catcampus/index.sqlite3
# ---- ffmpeg（视频抽帧用。不配则视频识别退化为取封面帧）----
FFMPEG=ffmpeg
FFPROBE=ffprobe
# 最多抽多少帧参与投票
MAX_FRAMES=8
# ---- 请求下载超时（秒）----
FETCH_TIMEOUT=15
