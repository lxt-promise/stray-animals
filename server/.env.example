# ---- 服务鉴权（与云函数 AI_TOKEN 保持一致）----
API_TOKEN=change-me-please

# ---- 模型设备：auto / cpu / cuda ----
DEVICE=auto

# ---- ReID 骨干：动物个体识别专用预训练模型（无需自己训练）----
# ONNX 优先（推荐）。留空则退回 torch/timm 在线加载；两者都不可用则走内置哈希占位引擎
REID_ONNX=
REID_SIZE=224
# torch 模式下的权重来源
REID_TORCH=timm/vit_large_patch14_dinov2.lvd142m

# ---- 猫体检测：YOLO ONNX（默认启用）----
# 仓库自带 models/yolov8n.onnx（12.8MB，COCO 80 类，class 15 = cat），
# **留空即自动发现它**（DETECT_AUTO=1）。所以正常情况下你什么都不用配。
#
# 想关掉：DETECT_ONNX=off（或 none / 0 / false），或者 DETECT_AUTO=0
# 想换权重：DETECT_ONNX=/path/to/your.onnx（显式路径优先于自动发现）
#
# 为什么值得开：整图提特征时背景会进向量（那只猫总在同一块草坪前 → 换个地方就不认）；
# 顺带让花色分析有货可判 —— 实测同一张「绿墙前的白猫」，不开检测时色域被绿墙刷满，
# 返回「画面里没有可用于判断花色的区域」，开了检测才判出「白猫 / 纯白」。
#
# 实测成本（本机 16 核 CPU，640×640 输入）：检测 ~58ms/张
#   单图端到端 204ms → ~270ms；8 帧视频 ~1450ms → **924ms**
#   （检测只跑一次、多帧复用同一个框，见 engine.analyze_frames）
#
# ⚠️ 2026-10-15：配上后曾 100% 复现 500（Add 节点 257 by 1370）。根因是检测框
# 裁出的 crop 长宽比与原图差很多时 letterbox 缩放系数失效（已修：一律按传入图
# 自身尺寸算，出口还自检形状）。
# ⚠️ 2026-10-17：又修了两个坐标 bug（它们只在配了检测后才会跑到）：
#   ① 模型输出是 cxcywh，旧代码按 xyxy 读 → 框出的是猫的胸口一小块；
#   ② 逆变换用 w/size、h/size（拉伸系数），而预处理是 letterbox（保比例 + 补边）
#      → 非方图的框整体错位，越扁错得越多。
# 回归：server/tests/test_detector_box.py（20 项，含真模型 + 真猫图）
#       server/tests/test_analyze_frames.py（7 项，含「不许每帧都检测」）
DETECT_ONNX=
DETECT_AUTO=1
DETECT_CONF=0.35
# 检测框外扩比例。检测框天生贴得紧，耳尖/尾巴常被切在框外，外扩 8% 能把它们带回来。
# ⚠️ 外扩只作用于**提特征**用的 crop；花色统计用的是没外扩的紧绷框 ——
#    多扩一圈就会把墙面/木桌算进色域，实测白猫会从「纯白」变成「颜色不集中」判不出来。
DETECT_PAD=0.08
# 是否把检测框扩成正方形再裁剪（默认关；开启需配合上面的尺寸修复）
DETECT_COLLAPSE_SQUARE=0
# 单张素材下载上限（字节）。云存储里的手机原图动辄 8~12MB，
# 上限太小会让补库/识别静默跳过（日志只有一行「下载失败 … 超过大小上限」）
MAX_IMAGE_BYTES=10485760

# ---- 毛色 / 花纹 / 品种（花色）识别 ----
#
# 两层：
#   1. CLIP 零样本分类（USE_CLIP=1，要 torch + open_clip，镜像 +600MB，最准）
#   2. app/attrs.py 的纯 numpy 色域分析（**零额外依赖，默认开着**，单图 ~5ms）
# 第 1 层没开、或置信度低于 ATTR_CONF_MIN 时自动落到第 2 层。
# 关掉 CLIP 也能拿到花色 —— 2026-10-17 之前这里为空，界面只有「检测/帧数」两张卡。
USE_CLIP=0
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# CLIP 置信度低于此值就改用色域分析（0.5 = 用户提的 50% 线）
ATTR_CONF_MIN=0.5
# 本地判定口径（2026-11-10）：pattern / legacy
#   pattern = tools/pattern_recognize.py  6 色桶 + 分带布局 + 斑块度 +
#             边缘肤色剔除（"看图说话"口径，默认）
#   legacy  = app/attrs.py   8 色桶 + 条纹频率 + 曝光平移（旧口径，可回退）
# 两套输出契约相同，切换只改判定口径，不影响 engine/search/前端。
# 实测（同一次检测 + 同一张掩膜，品种/毛色/花纹三项一致率）：
#   20 张实拍（原图）    pattern 20/20              legacy 18/20（两张裁剪图拒识）
#   16 张标准照          pattern 16/16              legacy 15/16
# pattern 加载/运行失败会自动回退 legacy，不会成为单点故障。
ATTR_ENGINE=pattern
# 条纹显著度门槛，低于它判「纯色」
ATTR_STRIPE_MIN=0.35
# 有效猫色区域占比低于它就不给结论（返回空 + 原因，不硬编颜色）
ATTR_MIN_COVERAGE=0.22
# 属性分析缩略图边长
ATTR_ANALYZE_SIZE=96
# 照片可用性门控（2026-11-05）：糊片 / 几乎找不到猫体时返回空 + 重拍提示，
# 而不是用噪声直方图硬凑一个花色。阈值是 34 张真实素材实测的保守下限。
# ATTR_QUALITY_GATE=0 可整层关闭（排查误拦时用）。
ATTR_QUALITY_GATE=1
ATTR_MIN_SHARP=10         # 512 长边、前景区域 Laplacian 方差下限
ATTR_MIN_FG=0.005         # 掩膜前景占画面比例下限（0.5%）
ATTR_SHARP_SIZE=512       # 清晰度计算的长边上限
# L1 稳健统计（瓦片剔离群，2026-11-05）：评估台上与默认链路结果完全一致，
# 默认关闭；出现「小面积局部遮挡导致误判」的现场时可开 ATTR_ROBUST_STATS=1 验证。
ATTR_ROBUST_STATS=0
ATTR_ROBUST_TILE=3
ATTR_ROBUST_MIN_TILE=0.3
ATTR_ROBUST_DIST=0.25
ATTR_ROBUST_MAD=3.0
# 口径一致性门控（2026-11-05）：套掩膜与不套掩膜两次统计若给出**互斥**花色、
# 且掩膜横向覆盖不足（抠图把猫体丢了一块），则弃权并提示重拍，而不是硬判。
# ATTR_CONSISTENCY_GATE=0 可关闭（排查误拦时用）。
ATTR_CONSISTENCY_GATE=1
ATTR_MASK_EXTENT_MIN=0.70
# 可选的远程属性识别接口（自建服务 / 公开 API / 云函数）。
# 留空 = 纯本地离线运行，不发任何网络请求。协议见 app/attrs.py 的 _remote()。
# 远程失败会自动降级到本地色域分析，不会成为单点故障。
ATTR_API_URL=
ATTR_API_TOKEN=
ATTR_API_TIMEOUT=4
# 档案花色为空时的展示分上限（0=关闭）。只降分不剔除：
# 空值不代表花色冲突，档案没填也可能就是同一只猫。
ATTR_UNKNOWN_CAP=60
# 身份识别的最低可采信分（0~99）。低于它时结果标 identified=false，
# 前端展示「没认出是哪只，但看起来是……」
IDENTIFY_MIN=45

# ---- agnes 大模型（兼容 OpenAI Chat Completions 格式）----
# 端点会补成 https://api.agnes-ai.cn/v1/chat/completions（OpenAI 协议）
# 封装见 app/agnes.py。
#
# ⚠️ AGNES_API_KEY 必填：留空 = 接口不可用（调用会返回「未配置」错误，
#    不会把空 key 发给远端）。由部署方填写。
AGNES_API_BASE=https://api.agnes-ai.cn/v1
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash
AGNES_TIMEOUT=30

# ---- 特征库持久化 ----
# 后端二选一：sqlite（本地文件，默认）| cos（腾讯云对象存储）
# 云托管等无持久盘环境必须用 cos，否则容器一重建特征库就归零
INDEX_BACKEND=sqlite
# sqlite 后端的数据文件路径
INDEX_DB=/data/catcampus/index.sqlite3
# cos 后端参数（INDEX_BACKEND=cos 时必配前四个；每猫一对象 <INDEX_PREFIX><cat_id>.bin）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_TOKEN=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_ENDPOINT=
INDEX_PREFIX=index/
# ---- ffmpeg（视频抽帧用。不配则视频识别退化为取封面帧）----
FFMPEG=ffmpeg
FFPROBE=ffprobe
# 最多抽多少帧参与投票
MAX_FRAMES=8
# ---- 请求下载超时（秒）----
FETCH_TIMEOUT=15

# ---- 猫咪标准照生成（POST /v1/photo/standard）----
#
# 上传一张猫照 → 返回两张 AI 标准照（<name>1.png 全身站姿 / <name>2.png 正面标准）。
#
# 两种后端，按配置自动选择：
#   · 默认用 agnes 图片模型（带参考图 i2i）：把原图作为参考图发过去，生成结果
#     保持「同一只猫」的毛色/花纹/眼色/脸型/体型。需要填上面的 AGNES_API_KEY。
#   · 显式配置 IMAGE_GEN_URL 时优先走该模板（只能传提示词，无参考图），用于接其它服务商。
# 两种都没配置 → 接口返回 503（不会用本地拼图伪造结果）。
#
# IMAGE_GEN_URL 是请求模板，支持 {prompt} 和 {image_size} 两个占位符：
#   IMAGE_GEN_URL=https://api.example.com/v1/images/generate?prompt={prompt}&size={image_size}
# 不含占位符时会自动追加 ?prompt=...&image_size=...
IMAGE_GEN_URL=
# 可选 Bearer Token（仅 IMAGE_GEN_URL 模板用；部分服务商要求 Authorization: Bearer <key>）
IMAGE_GEN_TOKEN=
# agnes 图片模型（走 /images/generations，带 image 字段即 i2i）
IMAGE_GEN_MODEL=agnes-image-2.1-flash
# 单张生成超时（秒）—— 文生图通常 10~60s，一次请求生成两张
IMAGE_GEN_TIMEOUT=120
# 生图服务返回图片 URL 时的下载上限（字节）
IMAGE_GEN_MAX_BYTES=20971520
# 两张图的画幅。只接受 "1K/2K/3K/4K" 或 "WIDTHxHEIGHT"（agnes 不认 landscape_4_3 这类命名）
IMAGE_GEN_SIZE_FULL=2048x1536
IMAGE_GEN_SIZE_FRONT=2048x2048
# 可选：save=true 时把结果落盘的目录；留空则只返回 base64
IMAGE_GEN_DIR=
