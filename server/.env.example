# ---- 服务鉴权（与云函数 AI_TOKEN 保持一致）----
API_TOKEN=change-me-please

# ---- 模型设备：auto / cpu / cuda ----
DEVICE=auto

# ---- ReID 骨干：动物个体识别专用预训练模型（无需自己训练）----
# ONNX 优先（推荐）。留空则退回 torch/timm 在线加载；两者都不可用则走内置哈希占位引擎
REID_ONNX=
REID_SIZE=224
# torch 模式下的权重来源
REID_TORCH=timm/vit_large_patch14_dinov2.lvd142m

# ---- 猫体检测：YOLO ONNX；留空则不检测、直接整图提特征 ----
# ⚠️ 2026-10-15：配上后曾 100% 复现 500（Add 节点 257 by 1370）。根因是检测框
# 裁出的 crop 长宽比与原图差很多时 letterbox 缩放系数失效（已修：一律按传入图
# 自身尺寸算，出口还自检形状）。要开请先跑 server/tests/test_engine_shape.py。
DETECT_ONNX=
DETECT_CONF=0.35
# 是否把检测框扩成正方形再裁剪（默认关；开启需配合上面的尺寸修复）
DETECT_COLLAPSE_SQUARE=0
# 单张素材下载上限（字节）。云存储里的手机原图动辄 8~12MB，
# 上限太小会让补库/识别静默跳过（日志只有一行「下载失败 … 超过大小上限」）
MAX_IMAGE_BYTES=10485760

# ---- 是否需要毛色/花纹属性（CLIP 零样本分类，关闭可省 ~600MB 显存）----
USE_CLIP=0
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# ---- 特征库持久化 ----
# 后端二选一：sqlite（本地文件，默认）| cos（腾讯云对象存储）
# 云托管等无持久盘环境必须用 cos，否则容器一重建特征库就归零
INDEX_BACKEND=sqlite
# sqlite 后端的数据文件路径
INDEX_DB=/data/catcampus/index.sqlite3
# cos 后端参数（INDEX_BACKEND=cos 时必配前四个；每猫一对象 <INDEX_PREFIX><cat_id>.bin）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_TOKEN=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_ENDPOINT=
INDEX_PREFIX=index/
# ---- ffmpeg（视频抽帧用。不配则视频识别退化为取封面帧）----
FFMPEG=ffmpeg
FFPROBE=ffprobe
# 最多抽多少帧参与投票
MAX_FRAMES=8
# ---- 请求下载超时（秒）----
FETCH_TIMEOUT=15
