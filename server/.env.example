# ---- 服务鉴权（与云函数 AI_TOKEN 保持一致）----
API_TOKEN=change-me-please

# ---- 模型设备：auto / cpu / cuda ----
DEVICE=auto

# ---- ReID 骨干：动物个体识别专用预训练模型（无需自己训练）----
# ONNX 优先（推荐）。留空则退回 torch/timm 在线加载；两者都不可用则走内置哈希占位引擎
REID_ONNX=
REID_SIZE=224
# torch 模式下的权重来源
REID_TORCH=timm/vit_large_patch14_dinov2.lvd142m

# ---- 猫体检测：YOLO ONNX（默认启用）----
# 仓库自带 models/yolov8n.onnx（12.8MB，COCO 80 类，class 15 = cat），
# **留空即自动发现它**（DETECT_AUTO=1）。所以正常情况下你什么都不用配。
#
# 想关掉：DETECT_ONNX=off（或 none / 0 / false），或者 DETECT_AUTO=0
# 想换权重：DETECT_ONNX=/path/to/your.onnx（显式路径优先于自动发现）
#
# 为什么值得开：整图提特征时背景会进向量（那只猫总在同一块草坪前 → 换个地方就不认）；
# 顺带让花色分析有货可判 —— 实测同一张「绿墙前的白猫」，不开检测时色域被绿墙刷满，
# 返回「画面里没有可用于判断花色的区域」，开了检测才判出「白猫 / 纯白」。
#
# 实测成本（本机 16 核 CPU，640×640 输入）：检测 ~58ms/张
#   单图端到端 204ms → ~270ms；8 帧视频 ~1450ms → **924ms**
#   （检测只跑一次、多帧复用同一个框，见 engine.analyze_frames）
#
# ⚠️ 2026-10-15：配上后曾 100% 复现 500（Add 节点 257 by 1370）。根因是检测框
# 裁出的 crop 长宽比与原图差很多时 letterbox 缩放系数失效（已修：一律按传入图
# 自身尺寸算，出口还自检形状）。
# ⚠️ 2026-10-17：又修了两个坐标 bug（它们只在配了检测后才会跑到）：
#   ① 模型输出是 cxcywh，旧代码按 xyxy 读 → 框出的是猫的胸口一小块；
#   ② 逆变换用 w/size、h/size（拉伸系数），而预处理是 letterbox（保比例 + 补边）
#      → 非方图的框整体错位，越扁错得越多。
# 回归：server/tests/test_detector_box.py（20 项，含真模型 + 真猫图）
#       server/tests/test_analyze_frames.py（7 项，含「不许每帧都检测」）
DETECT_ONNX=
DETECT_AUTO=1
DETECT_CONF=0.35
# 检测框外扩比例。检测框天生贴得紧，耳尖/尾巴常被切在框外，外扩 8% 能把它们带回来。
# ⚠️ 外扩只作用于**提特征**用的 crop；花色统计用的是没外扩的紧绷框 ——
#    多扩一圈就会把墙面/木桌算进色域，实测白猫会从「纯白」变成「颜色不集中」判不出来。
DETECT_PAD=0.08
# 是否把检测框扩成正方形再裁剪（默认关；开启需配合上面的尺寸修复）
DETECT_COLLAPSE_SQUARE=0
# 单张素材下载上限（字节）。云存储里的手机原图动辄 8~12MB，
# 上限太小会让补库/识别静默跳过（日志只有一行「下载失败 … 超过大小上限」）
MAX_IMAGE_BYTES=10485760

# ---- 毛色 / 花纹 / 品种（花色）识别 ----
#
# 两层：
#   1. CLIP 零样本分类（USE_CLIP=1，要 torch + open_clip，镜像 +600MB，最准）
#   2. app/attrs.py 的纯 numpy 色域分析（**零额外依赖，默认开着**，单图 ~5ms）
# 第 1 层没开、或置信度低于 ATTR_CONF_MIN 时自动落到第 2 层。
# 关掉 CLIP 也能拿到花色 —— 2026-10-17 之前这里为空，界面只有「检测/帧数」两张卡。
USE_CLIP=0
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# CLIP 置信度低于此值就改用色域分析（0.5 = 用户提的 50% 线）
ATTR_CONF_MIN=0.5
# 条纹显著度门槛，低于它判「纯色」
ATTR_STRIPE_MIN=0.35
# 有效猫色区域占比低于它就不给结论（返回空 + 原因，不硬编颜色）
ATTR_MIN_COVERAGE=0.22
# 属性分析缩略图边长
ATTR_ANALYZE_SIZE=96
# 可选的远程属性识别接口（自建服务 / 公开 API / 云函数）。
# 留空 = 纯本地离线运行，不发任何网络请求。协议见 app/attrs.py 的 _remote()。
# 远程失败会自动降级到本地色域分析，不会成为单点故障。
ATTR_API_URL=
ATTR_API_TOKEN=
ATTR_API_TIMEOUT=4
# 身份识别的最低可采信分（0~99）。低于它时结果标 identified=false，
# 前端展示「没认出是哪只，但看起来是……」
IDENTIFY_MIN=50

# ---- 特征库持久化 ----
# 后端二选一：sqlite（本地文件，默认）| cos（腾讯云对象存储）
# 云托管等无持久盘环境必须用 cos，否则容器一重建特征库就归零
INDEX_BACKEND=sqlite
# sqlite 后端的数据文件路径
INDEX_DB=/data/catcampus/index.sqlite3
# cos 后端参数（INDEX_BACKEND=cos 时必配前四个；每猫一对象 <INDEX_PREFIX><cat_id>.bin）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_TOKEN=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_ENDPOINT=
INDEX_PREFIX=index/
# ---- ffmpeg（视频抽帧用。不配则视频识别退化为取封面帧）----
FFMPEG=ffmpeg
FFPROBE=ffprobe
# 最多抽多少帧参与投票
MAX_FRAMES=8
# ---- 请求下载超时（秒）----
FETCH_TIMEOUT=15
