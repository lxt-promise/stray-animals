.cat-card {
  display: flex;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.cat-card .avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}
.cat-card .avatar image { width: 100%; height: 100%; }
.rarity-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(146, 88, 32, .12);
}
.cat-card .info { flex: 1; min-width: 0; }
.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.name-row .name {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 300rpx;
}
/* 性别符号：粉♀ / 蓝♂，与绝育 tag 并列在名字后 */
.name-row .sex {
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.name-row .sex.male { color: #3B82F6; }
.name-row .sex.female { color: #EC4899; }
.meta { margin: 8rpx 0 12rpx; }
.tag-row { display: flex; flex-wrap: wrap; }
