/* 猫谱单行卡片：左头像、右信息、右箭头。
   信息三层：名字+性别+状态 / 花色·位置 / 绝育·稀有度·目击。
   卡片本身只做"轻卡"（细边框 + 极浅投影），列表滚动时才不会糊成一片。 */
.cat-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card);
  border: 2rpx solid var(--card-line);
  border-radius: var(--radius);
  box-shadow: 0 6rpx 18rpx rgba(146, 88, 32, .06);
  padding: 20rpx;
  margin-bottom: 18rpx;
}
.card-press { opacity: .72; transform: scale(.99); }

.cat-card .avatar {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.cat-card .avatar image { width: 100%; height: 100%; }
/* 稀有度色点：放到右上角并加白描边 —— 原来贴在右下、描边是半透明褐色，
   小尺寸下看起来像图片上的一个脏点，而不是"稀有度标记" */
.rarity-dot {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(67, 20, 7, .18);
}

.cat-card .info { flex: 1; min-width: 0; }
.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.name-row .name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  max-width: 300rpx;
  line-height: 1.3;
}
/* 性别符号：粉♀ / 蓝♂，与状态 tag 并列在名字后 */
.name-row .sex {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  line-height: 1;
}
.name-row .sex.male { color: #3B82F6; }
.name-row .sex.female { color: #EC4899; }
.meta { margin: 8rpx 0 10rpx; letter-spacing: .3rpx; }
.tag-row { display: flex; flex-wrap: wrap; }
/* 右侧箭头：让「这一行可以点开」有明确指向，也把内容与卡片边缘隔开 */
.cat-card .go {
  color: var(--text-weak);
  font-size: 34rpx;
  line-height: 1;
  flex-shrink: 0;
  margin-left: -4rpx;
}
