<view class="cat-card" wx:if="{{cat}}" bindtap="onTap">
  <view class="avatar">
    <image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError" />
    <text wx:else>🐱</text>
    <view class="rarity-dot" style="background: {{rarityItem.color}}"></view>
  </view>
  <view class="info">
    <view class="name-row">
      <text class="name ellipsis">{{cat.name}}</text>
      <text class="tag {{statusItem.tag}}">{{statusItem.label}}</text>
    </view>
    <view class="meta small muted ellipsis">
      {{patternLabel}} · {{cat.sex === 'male' ? '公' : (cat.sex === 'female' ? '母' : '性别未知')}}
      <text wx:if="{{showSpot && cat.location && cat.location.name}}"> · {{cat.location.name}}</text>
    </view>
    <view class="tag-row">
      <text class="tag {{sterItem.tag}}">{{sterItem.label}}</text>
      <text class="tag purple">{{rarityItem.label}}</text>
      <text class="tag gray" wx:if="{{cat.sightingCount}}">目击 {{cat.sightingCount}}</text>
    </view>
  </view>
</view>
