.pg-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .42);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.pg-sheet {
  width: 100%;
  background: #FFF7ED;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 40rpx 56rpx;
  box-sizing: border-box;
}
.pg-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #7C2D12;
  text-align: center;
}
.pg-sub {
  font-size: 24rpx;
  color: #9A8478;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 32rpx;
}
.pg-avatar {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}
.pg-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  background: #FFFFFF;
  border: 4rpx dashed #F59E0B;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}
.pg-avatar-btn::after { border: none; }
.pg-avatar-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
}
.pg-avatar-ph {
  font-size: 24rpx;
  color: #C2854F;
  text-align: center;
}
.pg-input {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border: 2rpx solid #FCD9B6;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #7C2D12;
  box-sizing: border-box;
  margin-bottom: 36rpx;
}
.pg-actions {
  display: flex;
  gap: 24rpx;
}
.pg-skip, .pg-ok {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.pg-skip {
  background: #FFFFFF;
  color: #9A8478;
  border: 2rpx solid #F1E3D6;
}
.pg-ok {
  background: #F97316;
  color: #FFFFFF;
}
.pg-ok.busy { opacity: .55; }
