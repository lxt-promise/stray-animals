/* ==========================================================
   喵园 CatCampus · 全局设计系统
   风格：暖阳柑橘（Warm Citrus）
   浅暖底 + 橙主色 + 黄辅色。明亮、亲和、有食欲感，
   贴合「校园 + 猫 + 投喂」的情绪；科技感由玻璃卡片、
   扫描线动效与霓虹描边承担，不再依赖黑底。
   ========================================================== */
page {
  /* —— 底色与面板 —— */
  --bg: #FFF7ED;
  --bg-2: #FFFFFF;
  --card: #FFFFFF;
  --card-soft: rgba(255, 255, 255, .72);
  --card-line: rgba(146, 88, 32, .12);

  /* —— 文字 —— */
  --text: #431407;
  --text-sub: #8C6A55;
  --text-weak: #B9A08C;

  /* —— 品牌 —— */
  --brand: #F97316;
  --brand-2: #FBBF24;
  --brand-dark: #C2410C;
  --brand-light: rgba(249, 115, 22, .12);
  --brand-grad: linear-gradient(135deg, #FBBF24 0%, #F97316 100%);
  --brand-grad-2: linear-gradient(135deg, #FDE68A 0%, #FBBF24 100%);

  /* —— 状态 —— */
  --ok: #2FA36B;       /* 已绝育 / 健康 */
  --warn: #E0483C;     /* 未绝育 / 需关注 */
  --info: #2F86D6;     /* 已领养 */
  --purple: #A855F7;   /* 寄养 / 特殊 */
  --gold: #EAB308;     /* 稀有度 / 积分 */

  /* —— 形状与光 —— */
  --radius: 28rpx;
  --radius-sm: 18rpx;
  --shadow: 0 10rpx 30rpx rgba(146, 88, 32, .1);
  --glow: 0 8rpx 26rpx rgba(249, 115, 22, .3);
  --glow-2: 0 8rpx 26rpx rgba(251, 191, 36, .38);
  --line: rgba(146, 88, 32, .1);

  background: var(--bg);
  background-image:
    radial-gradient(120% 50% at 6% -4%, rgba(251, 191, 36, .22) 0%, rgba(251, 191, 36, 0) 58%),
    radial-gradient(100% 46% at 96% 2%, rgba(249, 115, 22, .14) 0%, rgba(249, 115, 22, 0) 60%),
    radial-gradient(90% 40% at 50% 100%, rgba(234, 179, 8, .08) 0%, rgba(234, 179, 8, 0) 70%);
  background-repeat: no-repeat;
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, picker, image, scroll-view {
  box-sizing: border-box;
}

/* ===================== 页面容器 ===================== */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: transparent;
}

/* ===================== 卡片（玻璃拟态） ===================== */
.card {
  position: relative;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFBF6 100%);
  border: 2rpx solid var(--card-line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
/* 顶部霓虹细线 */
.card::before {
  content: '';
  position: absolute;
  left: 28rpx;
  top: 0;
  width: 96rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--brand-grad);
  opacity: .85;
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: .5rpx;
  margin-bottom: 20rpx;
}
.card-title .more {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 400;
}

/* 高亮数据卡（橙调发光） */
.card-glow {
  border-color: rgba(249, 115, 22, .3);
  box-shadow: var(--shadow), 0 0 40rpx rgba(249, 115, 22, .14);
}

/* ===================== 行信息 ===================== */
.row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
  font-size: 28rpx;
}
.row:last-child { border-bottom: none; }
.row .label { width: 180rpx; color: var(--text-sub); flex-shrink: 0; }
.row .value { flex: 1; color: var(--text); word-break: break-all; }

/* ===================== 按钮 ===================== */
.btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: var(--brand-grad);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: var(--glow);
  letter-spacing: 1rpx;
}

/* <button class="btn">：微信 button 自带 14px 左右内边距等 UA 样式，会把文字顶偏。
   统一改 flex 居中，保证任意场景（footer-bar、独立按钮）文字都在正中央。 */
button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 0;
  padding-right: 0;
}
.btn::after { border: none; }
.btn.btn-ghost {
  background: var(--brand-light);
  color: var(--brand-dark);
  border: 2rpx solid rgba(249, 115, 22, .28);
  box-shadow: none;
}
.btn.btn-plain {
  background: rgba(255, 255, 255, .06);
  color: var(--text);
  border: 2rpx solid var(--card-line);
  box-shadow: none;
}
.btn.btn-violet {
  background: var(--brand-grad-2);
  color: #7C3A00;
  box-shadow: var(--glow-2);
}
.btn.btn-sm {
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  border-radius: 34rpx;
  padding: 0 30rpx;
  box-shadow: none;
}
.btn.btn-block { width: 100%; }
.btn[disabled] { opacity: .45; }

/* ===================== 标签 ===================== */
/* 不用 inline-flex：胶囊里是裸文本节点，匿名 flex item 的居中
   在部分渲染器下不可靠（表现就是文字偏上/偏下）。
   改 inline-block + line-height 撑满内容高度，文字垂直居中由行高保证。 */
/* 状态胶囊：必须用在 <view> 上（<text> 是行内元素，盒模型样式不生效，
   会出现在文字跑出背景条之外的现象）。居中靠 line-height 撑满内容区，
   flex 行内靠 align-self + flex-shrink:0 + nowrap 防压缩防换行。 */
.tag {
  display: inline-block;
  box-sizing: border-box;
  height: 42rpx;
  line-height: 38rpx;      /* 高度 - 上下各 2rpx 边框 */
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  background: var(--brand-light);
  color: var(--brand-dark);
  border: 2rpx solid rgba(249, 115, 22, .22);
  margin-right: 12rpx;
  vertical-align: middle;
  text-align: center;
  white-space: nowrap;
  flex-shrink: 0;          /* flex 行内不被压缩 */
  align-self: center;      /* flex 行内垂直居中 */
}
.tag.ok     { background: rgba(47, 163, 107, .12);  color: var(--ok);     border-color: rgba(47, 163, 107, .24); }
.tag.warn   { background: rgba(224, 72, 60, .12);   color: var(--warn);   border-color: rgba(224, 72, 60, .24); }
.tag.info   { background: rgba(47, 134, 214, .12);  color: var(--info);   border-color: rgba(47, 134, 214, .24); }
.tag.gray   { background: rgba(146, 88, 32, .07);   color: var(--text-sub); border-color: var(--card-line); }
.tag.purple { background: rgba(168, 85, 247, .12);  color: var(--purple); border-color: rgba(168, 85, 247, .24); }
.tag.gold   { background: rgba(234, 179, 8, .14);   color: #A16207;       border-color: rgba(234, 179, 8, .28); }

/* 投喂状态标签：橙 = 欠投喂（需要行动），绿 = 近期已投喂 */
.tag.feed-warn { background: rgba(245, 158, 11, .16); color: #B45309; border-color: rgba(245, 158, 11, .38); }
.tag.feed-ok   { background: rgba(34, 197, 94, .14);  color: #15803D; border-color: rgba(34, 197, 94, .3); }

/* ===================== 空状态 ===================== */
.empty {
  padding: 110rpx 40rpx;
  text-align: center;
  color: var(--text-weak);
  font-size: 28rpx;
}
.empty .emoji { font-size: 90rpx; display: block; margin-bottom: 24rpx; opacity: .8; }

/* ===================== 表单 ===================== */
.form-item {
  background: #FFFFFF;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
  display: flex;
  align-items: center;
}
.form-item .label {
  width: 180rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}
.form-item input, .form-item textarea, .form-item picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}
.form-item textarea { min-height: 120rpx; }

/* ===================== 网格 ===================== */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.stat-grid .item { width: 33.33%; padding: 8rpx; }

/* ===================== 底部固定栏 ===================== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .96);
  border-top: 2rpx solid var(--card-line);
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

/* ===================== 科技装饰件 ===================== */
/* 扫描线 */
.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--brand), transparent);
  box-shadow: 0 0 20rpx rgba(249, 115, 22, .8);
  animation: scanY 2.6s ease-in-out infinite;
}
@keyframes scanY {
  0%   { top: 6%;  opacity: 0; }
  12%  { opacity: 1; }
  88%  { opacity: 1; }
  100% { top: 94%; opacity: 0; }
}
/* 呼吸光点 */
.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 16rpx var(--brand);
  animation: pulse 1.6s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: .35; transform: scale(.8); }
}
/* 网格底纹 */
.grid-bg {
  background-image:
    linear-gradient(rgba(146, 88, 32, .06) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(146, 88, 32, .06) 2rpx, transparent 2rpx);
  background-size: 40rpx 40rpx;
}
/* 等宽技术字 */
.mono {
  font-family: "SF Mono", "Roboto Mono", Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}
/* 渐变文字 */
.text-grad {
  background: var(--brand-grad);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
/* 分隔线 */
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(249, 115, 22, .4), rgba(249, 115, 22, 0));
  margin: 20rpx 0;
}
/* 骨架加载 */
.skeleton {
  background: linear-gradient(90deg, rgba(146, 88, 32, .05) 25%, rgba(146, 88, 32, .11) 37%, rgba(146, 88, 32, .05) 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  border-radius: 12rpx;
}
@keyframes shimmer {
  0%   { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ===================== 工具类 ===================== */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.muted { color: var(--text-sub); }
.small { font-size: 24rpx; }
.bold { font-weight: 600; }
/* 按压反馈：可点击胶囊/链接统一挂 hover-class="pressed"。
   <text> 不是交互宿主（无 hover 态、点击热区不稳定），可点元素一律用 <view>。 */
.pressed { opacity: .68; }
.mt { margin-top: 24rpx; }
.mb { margin-bottom: 24rpx; }
.flex { display: flex; align-items: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.text-center { text-align: center; }
