.tabs {
  display: flex;
  background: var(--card);
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.tabs .tab {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  border-radius: 32rpx;
}
.tabs .tab.on {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.member-item:last-child { border-bottom: none; }
.m-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 18rpx;
  overflow: hidden;
}
.m-avatar image { width: 100%; height: 100%; }
.m-info { flex: 1; }

.note { margin: 12rpx 0; line-height: 1.6; }
.apply-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.ok-tip {
  text-align: center;
  color: var(--ok);
  padding: 24rpx;
  font-size: 28rpx;
}
.form-item.col {
  flex-direction: column;
  align-items: flex-start;
}
.form-item.col .label { margin-bottom: 12rpx; }
.form-item.col textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
}
