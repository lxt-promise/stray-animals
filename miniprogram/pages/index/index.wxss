/* ===================== 顶部：校名 + 身份 ===================== */
.hero {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 8rpx 30rpx;
}
/* 右上柔光：冷白背景不再"平"，视觉重心被拉到校名上 */
.hero-glow {
  position: absolute;
  right: -40rpx;
  top: -70rpx;
  width: 330rpx;
  height: 330rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251, 191, 36, .30) 0%, rgba(249, 115, 22, .10) 52%, transparent 70%);
  pointer-events: none;
}
/* 左侧标题块恒定渲染（未绑定显示品牌名「喵园」），所以不再需要
   「只剩一个子元素时靠右对齐」的 no-school 兜底。 */
.hero-left { position: relative; z-index: 1; min-width: 0; }
.hero-right { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.school-name {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -.5rpx;
  line-height: 1.2;
  color: var(--text);
}
/* 副标题前加一个小圆点：与「我的」页的学校归属行同一套语言，
   比一行纯灰字更像"信息"而不是"备注" */
.school-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
  letter-spacing: .5rpx;
}
.sub-dot {
  display: block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
}
.role-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(146, 88, 32, .06);
  color: var(--text-sub);
  font-size: 22rpx;
  border: 2rpx solid var(--card-line);
  white-space: nowrap;
}
.role-badge.member {
  background: rgba(249, 115, 22, .12);
  color: var(--brand);
  border-color: rgba(249, 115, 22, .3);
}
/* 右上角在线指示灯 */
.ai-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 26rpx;
  background: rgba(251, 191, 36, .1);
  border: 2rpx solid rgba(251, 191, 36, .25);
  white-space: nowrap;
}
.ai-status .txt { font-size: 20rpx; color: #B45309; letter-spacing: 1rpx; }

/* ===================== 识别入口卡 ===================== */
.ai-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  border: 2rpx solid rgba(249, 115, 22, .3);
  background:
    linear-gradient(135deg, rgba(249, 115, 22, .14) 0%, rgba(251, 191, 36, .12) 55%, rgba(234, 179, 8, .1) 100%);
  box-shadow: var(--shadow), 0 0 46rpx rgba(249, 115, 22, .14);
  padding: 32rpx 30rpx 30rpx;
  margin-bottom: 24rpx;
}
.ai-card .grid-bg-layer {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(146, 88, 32, .05) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(146, 88, 32, .05) 2rpx, transparent 2rpx);
  background-size: 44rpx 44rpx;
}
.ai-card .scan-line { position: absolute; left: 0; right: 0; }
/* 猫剪影：只做氛围。压在网格上一层的右下角，透明度低到不干扰正文，
   也绝不超过文字可读性（它同时也是"这是一只猫"的视觉符号）。 */
.ai-mascot {
  position: absolute;
  right: -16rpx;
  bottom: -24rpx;
  font-size: 210rpx;
  line-height: 1;
  opacity: .18;
  transform: rotate(-8deg);
  pointer-events: none;
}
.ai-card-inner { position: relative; z-index: 2; }
.ai-head { display: flex; align-items: center; gap: 14rpx; }
.ai-head .badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: rgba(146, 88, 32, .16);
  border: 2rpx solid rgba(249, 115, 22, .32);
  font-size: 19rpx;
  color: var(--brand-dark);
  letter-spacing: 1rpx;
}
/* 次要徽章（版本号）弱化：两个同等强度的胶囊会抢掉标题的注意力 */
.ai-head .badge.dim {
  background: rgba(255, 255, 255, .5);
  border-color: rgba(251, 191, 36, .45);
  color: #B45309;
}
.ai-title {
  font-size: 42rpx;
  font-weight: 800;
  margin-top: 20rpx;
  line-height: 1.28;
  letter-spacing: 0;
}
.ai-desc {
  font-size: 25rpx;
  color: rgba(67, 20, 7, .72);
  margin-top: 12rpx;
  line-height: 1.6;
  max-width: 470rpx;
}
.ai-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.ai-btn {
  position: relative;
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.ai-btn.photo {
  background: var(--brand-grad);
  color: #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(249, 115, 22, .35);
}
.ai-btn.video {
  background: rgba(255, 255, 255, .52);
  color: var(--text);
  border: 2rpx solid rgba(146, 88, 32, .16);
}
.ai-btn .ico { font-size: 30rpx; }
/* 主按钮右侧的箭头：暗示"点进去还有下一步"，同时把按钮的视线往右带 */
.ai-btn .go {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-52%);
  font-size: 32rpx;
  opacity: .75;
  font-weight: 400;
}
.btn-press { opacity: .85; transform: scale(.985); }

/* ===================== 统计卡 ===================== */
/* 横排版式：左图标方块 + 右侧「标签 / 数值」两行。
   三格并排宽度只有 ~200rpx，竖排（图标上、数字下）会把数字压到 40rpx 以上才好看；
   横排把图标塞到左边，右侧腾出的宽度刚好够 4 字标签 + 3 位数字。
   配色：卡底 = 图标原来的浅橙底色（#FEF2E7），图标块再压深一档，
   形成「同色不同层」的关系；页面底色本身也是暖白，所以卡必须靠边框 + 暖投影立起来。 */
.stat-grid { margin: 0 -8rpx; }
.stat-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FEF2E7;
  border: 2rpx solid rgba(249, 115, 22, .18);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(249, 115, 22, .09);
  padding: 22rpx 12rpx;
  text-align: left;
}
/* 图标底：与卡底只差一档（.11 ≈ #FDE7D8），衬在 #FEF2E7 上有边界但不抢数字的视觉重量。
   原来是 .20（≈#FCE2D0），比卡底深太多，三个图标连成三条深色块，数字反而被压住。 */
.stat-ico {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 18rpx;
  background: rgba(249, 115, 22, .11);
  border: 2rpx solid rgba(249, 115, 22, .18);
  font-size: 28rpx;
  text-align: center;
}
.stat-ico.sk {
  /* 骨架的扫光色跟着新底色走（原来的灰米在浅橙卡上发脏）；
     图标底已从 .20 降到 .11，扫光深端同步提亮，否则骨架比真内容还深 */
  background: linear-gradient(90deg, #F9E9DC 25%, #FDF3EA 50%, #F9E9DC 75%);
  background-size: 300rpx 100%;
  border-color: transparent;
  animation: sk-sweep 1.1s linear infinite;
}
/* min-width:0 让文本区能在 flex 里真正被压缩，否则长标签会把卡片撑破 */
.stat-body { flex: 1; min-width: 0; }
.stat-card .num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-dark);
  line-height: 1.1;
  letter-spacing: -0.5rpx;
  /* 小字号下 16rpx 光晕会把笔画糊成一团，收到 10rpx */
  text-shadow: 0 0 10rpx rgba(249, 115, 22, .18);
}
.stat-card .num .unit { font-size: 22rpx; letter-spacing: 0; }
.stat-card .lbl {
  font-size: 21rpx;
  color: var(--text-sub);
  line-height: 1.2;
  margin-bottom: 4rpx;
  letter-spacing: .3rpx;
  white-space: nowrap;
}
/* 三格都可点：按压时轻微缩小 + 变淡，给出"我点到了"的反馈 */
.stat-hover { opacity: .72; transform: scale(.97); }

/* 统计骨架：尺寸与真实内容一致，占住高度避免下方内容被"顶"下来 */
.stat-card.skeleton { box-shadow: none; }
.stat-card.skeleton .sk {
  border-radius: 10rpx;
  background: linear-gradient(90deg, #F6E3D3 25%, #FDF0E4 50%, #F6E3D3 75%);
  background-size: 300rpx 100%;
  animation: sk-sweep 1.1s linear infinite;
}
.stat-card .num.sk { width: 72rpx; height: 38rpx; margin-top: 6rpx; }
.stat-card .lbl.sk { width: 66rpx; height: 20rpx; }

@keyframes sk-sweep {
  0%   { background-position: -150rpx 0; }
  100% { background-position: 150rpx 0; }
}

/* ===================== 快捷操作 ===================== */
.quick-row { display: flex; gap: 20rpx; }
.quick-btn {
  position: relative;
  overflow: hidden;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFBF6 100%);
  border: 2rpx solid var(--card-line);
  border-radius: 24rpx;
  box-shadow: var(--shadow);
  padding: 24rpx 10rpx 22rpx;
  text-align: center;
}
/* 图标收进浅色圆底：emoji 裸排会跟着字体上下飘，加了固定尺寸的圆形底
   后两个按钮的图标基线一致，整排看起来才是「一对」而不是两个色块 */
.quick-btn .ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  background: rgba(249, 115, 22, .09);
  border: 2rpx solid rgba(249, 115, 22, .14);
}
.quick-btn .txt { font-size: 28rpx; font-weight: 600; color: var(--text); }
.quick-btn .sub {
  font-size: 22rpx;
  color: var(--text-weak);
  transform: scale(.96);
}
/* 主按钮用**与识别卡同一套浅橙**（.14 → .12 → .10 渐变 + .3 边框）而不是饱和橙：
   首页一屏里已经有一块强橙（识别卡），主按钮再饱和就两块互相抢；
   改成同色浅底后，主次关系靠"左边是入口、右边是次级"的位置而不是靠饱和度。
   文字随之从白色改为深色 —— 浅底白字对比度不够。 */
.quick-btn.primary {
  background:
    linear-gradient(135deg, rgba(249, 115, 22, .14) 0%, rgba(251, 191, 36, .12) 55%, rgba(234, 179, 8, .1) 100%);
  border-color: rgba(249, 115, 22, .3);
  box-shadow: 0 8rpx 20rpx rgba(249, 115, 22, .12);
}
.quick-btn.primary .ico {
  background: rgba(249, 115, 22, .16);
  border-color: rgba(249, 115, 22, .24);
}
.quick-btn.primary .txt { color: var(--brand-dark); }
.quick-btn.primary .sub { color: var(--text-sub); }

/* ===================== 最新目击 ===================== */
.feed-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.feed-item:last-child { border-bottom: none; }
.feed-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  background: rgba(146, 88, 32, .06);
  border: 2rpx solid var(--card-line);
  box-shadow: 0 4rpx 12rpx rgba(146, 88, 32, .07);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.feed-avatar image { width: 100%; height: 100%; }
.feed-main { flex: 1; min-width: 0; }
.feed-title { display: flex; align-items: center; gap: 12rpx; }
.feed-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  max-width: 330rpx;
}
/* 时间靠右上：原来和上报人挤在最后一行，扫读时抓不到「这是多久前的事」 */
.feed-time {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--text-weak);
  flex-shrink: 0;
}
.feed-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.feed-loc { max-width: 300rpx; }
.feed-sep { color: var(--text-weak); }
.feed-by { color: var(--text-weak); flex-shrink: 0; }
.feed-note { margin-top: 8rpx; line-height: 1.55; color: var(--text-sub); }
.feed-arrow { color: var(--text-weak); font-size: 34rpx; flex-shrink: 0; }
