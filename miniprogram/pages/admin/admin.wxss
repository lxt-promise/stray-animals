/* 超级管理后台 */
.tip {
  margin-top: 16rpx;
  line-height: 1.7;
}

/* 成员管理 */
.member { align-items: center; justify-content: space-between; }
.m-info { display: flex; align-items: center; }
.m-name { font-size: 30rpx; font-weight: 600; margin-right: 14rpx; max-width: 320rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.m-actions { display: flex; gap: 10rpx; }
.op {
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(146, 88, 32, .06);
  color: var(--text-sub);
  border: 2rpx solid var(--card-line);
}
.op.on {
  background: var(--brand-light);
  color: var(--brand-dark);
  border-color: rgba(249, 115, 22, .4);
  font-weight: 600;
}
.locked {
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  color: var(--text-sub);
  background: rgba(146, 88, 32, .06);
  border: 2rpx solid var(--card-line);
}

/* 上传记录管理 */
.s-item { align-items: center; justify-content: space-between; }
.s-main { flex: 1; margin-right: 20rpx; min-width: 0; }
.danger {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--warn);
  padding: 12rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(224, 72, 60, .3);
  background: rgba(224, 72, 60, .08);
}

/* 特征库维护 */
.build-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 24rpx;
  background: var(--brand);
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, .25);
}
.build-btn.busy { opacity: .6; }
