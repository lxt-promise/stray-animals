<view class="page">

  <view class="card">
    <view class="card-title">你遇见了谁</view>
    <view class="form-item">
      <text class="label">猫咪</text>
      <picker mode="selector" range="{{catNames}}" value="{{catIndex}}" bindchange="onCatPick">
        <view>{{catNames[catIndex] || '选择猫咪 ›'}}</view>
      </picker>
    </view>
    <!-- 未建档的猫：用**结构化特征**描述，不提供自由命名（避免用户生成文字）。
         正式名字由社团核实后统一分配（服务端按毛色生成占位名，如「未命名·橘猫」）。 -->
    <block wx:if="{{isNewCat}}">
      <view class="form-item">
        <text class="label">毛色 / 花纹</text>
        <picker mode="selector" range="{{patternOptions}}" range-key="label" value="{{patternIndex}}" bindchange="onPatternPick">
          <view>{{patternOptions[patternIndex].label}} ›</view>
        </picker>
      </view>
    </block>
    <view class="small muted" style="padding:16rpx 28rpx">
      选「不指定」表示这是一只尚未建档的猫，社团成员核实后会为它建立正式档案并命名。
    </view>
  </view>

  <view class="card">
    <view class="card-title">照片</view>
    <view class="upload-row">
      <view class="upload-box" wx:for="{{photos}}" wx:key="*this" data-index="{{index}}" bindtap="removePhoto">
        <image src="{{item}}" mode="aspectFill" />
      </view>
      <view class="upload-box" bindtap="choosePhotos">
        <view>
          <view class="plus">+</view>
          <view class="small muted">拍照</view>
        </view>
      </view>
    </view>
    <view class="small muted" style="margin-top:12rpx">
      照片用于社团核实猫只身份与健康状况，最多 6 张
    </view>
  </view>

  <view class="card">
    <view class="card-title">位置</view>
    <!-- 地点一律通过微信「选择位置」获取（返回结构化名称），不再提供自由文本输入 -->
    <view class="form-item">
      <text class="label">地点</text>
      <view bindtap="chooseLocation" class="loc-pick">
        {{locationName || (locating ? '定位中…' : (location ? '已获取定位，点此修改 ›' : '点此选择位置 ›'))}}
      </view>
    </view>
    <view class="small muted" style="padding:0 28rpx 8rpx">
      点位来自微信地图选择，用于社团核实猫只活动范围
    </view>
  </view>

  <view class="card">
    <view class="card-title">状况</view>
    <view class="form-item">
      <text class="label">投喂状态</text>
      <picker mode="selector" range="{{feedOptions}}" range-key="label" value="{{feedIndex}}" bindchange="onFeedPick">
        <view>{{feedOptions[feedIndex].label}} ›</view>
      </picker>
    </view>
    <!-- 食物类型：只影响积分档位（+2 ~ +5）。用 picker 而非输入框 ——
         打卡页必须零自由文本输入（合规：UGC 文本属于「社交-笔记」类目，个人主体未开放）。 -->
    <view class="form-item" wx:if="{{feedValue === 'fed'}}">
      <text class="label">食物类型</text>
      <picker mode="selector" range="{{foodOptions}}" range-key="label" value="{{foodIndex}}" bindchange="onFoodPick">
        <view>{{foodOptions[foodIndex].label}} ›</view>
      </picker>
    </view>
    <view class="feed-hint" wx:if="{{feedValue === 'fed'}}">
      投喂按食物类型计入积分：干粮 +2 / 零食 +3 / 罐头 +4 / 自制 +5
    </view>
    <view class="feed-hint" wx:if="{{feedValue === 'fedByOther'}}">
      记录「已被其他人投喂」，提醒其他同学避免重复投喂
    </view>
    <view class="form-item">
      <text class="label">健康观察</text>
      <picker mode="selector" range="{{healthOptions}}" range-key="label" value="{{healthIndex}}" bindchange="onHealthPick">
        <view>{{healthOptions[healthIndex].label}} ›</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">数量</text>
      <picker mode="selector" range="{{countOptions}}" value="{{countIndex}}" bindchange="onCountPick">
        <view>{{countOptions[countIndex]}} 只 ›</view>
      </picker>
    </view>
    <!-- ⚠️ 合规改造（2026-10-16 审核驳回「社交-笔记」类目）：
         本页**不得有任何自由文字输入**。审核认定「用户自行生成文字 + 图片 + 公开可见」
         即构成「社交-笔记」（个人主体未开放类目）。
         所有用户输入一律改为**预设选项**：多选标签 / 单选枚举。
         形态是「登记猫况」而非「创作笔记」，与「工具-信息查询」类目相符。
         新增维度时请加枚举项（const.js），不要把 input/textarea 加回来。 -->
    <view class="form-item col">
      <text class="label">见到它在做什么</text>
      <view class="tag-picker">
        <view
          wx:for="{{behaviorOptions}}"
          wx:key="value"
          class="tag-chip {{item.on ? 'on' : ''}}"
          data-value="{{item.value}}"
          bindtap="toggleBehavior"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="form-item col">
      <text class="label">外观特征（可多选）</text>
      <view class="tag-picker">
        <view
          wx:for="{{featureOptions}}"
          wx:key="value"
          class="tag-chip {{item.on ? 'on' : ''}}"
          data-value="{{item.value}}"
          bindtap="toggleFeature"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- ⚠️ 可见性开关已**移出本页**（合规二审 2026-10-16）：
       打卡者不再有"公开到校园"的入口 —— 公开与否由超级管理员在控制台按校区统一配置。
       本页只提示当前策略结果，不提供任何发布按钮。 -->
  <view class="card">
    <view class="card-title">可见性</view>
    <view class="small muted" style="line-height:1.7">
      打卡记录默认**仅你自己与社团成员可见**。是否对访客公开由社团管理员统一设置，
      你无需（也无法）在此选择。
    </view>
  </view>

  <view class="footer-bar">
    <button class="btn btn-block" bindtap="submit" disabled="{{submitting}}">提交打卡</button>
  </view>

</view>
