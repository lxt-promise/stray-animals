.upload-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.upload-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.upload-box image { width: 100%; height: 100%; }
.plus { font-size: 48rpx; color: var(--text-weak); line-height: 1; }

.loc-pick { flex: 1; color: var(--brand-dark); }

.form-item.col {
  flex-direction: column;
  align-items: flex-start;
}
.form-item.col .label { margin-bottom: 12rpx; }
.form-item.col textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
}
