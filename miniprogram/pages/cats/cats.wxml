<view class="page">

  <view class="tabs">
    <view class="tab {{tab === 'cat' ? 'on' : ''}}" data-tab="cat" bindtap="switchTab">猫谱</view>
    <view class="tab {{tab === 'sighting' ? 'on' : ''}}" data-tab="sighting" bindtap="switchTab">目击动态</view>
  </view>

  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索猫咪名字 / 花色"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
  </view>

  <!-- 筛选 -->
  <scroll-view scroll-x class="filter-scroll" wx:if="{{tab === 'cat'}}">
    <view class="filter-row">
      <view
        class="chip {{filters.status === '' ? 'on' : ''}}"
        data-key="status" data-value="" bindtap="onFilter" hover-class="pressed">全部状态</view>
      <block wx:for="{{statusOptions}}" wx:key="value">
        <view
          class="chip {{filters.status === item.value ? 'on' : ''}}"
          data-key="status" data-value="{{item.value}}" bindtap="onFilter" hover-class="pressed">{{item.label}}</view>
      </block>
    </view>
  </scroll-view>

  <scroll-view scroll-x class="filter-scroll" wx:if="{{tab === 'cat'}}">
    <view class="filter-row">
      <view class="chip {{filters.sterilized === 'no' ? 'on' : ''}}"
        data-key="sterilized" data-value="no" bindtap="onFilter" hover-class="pressed">未绝育优先</view>
      <view class="chip {{filters.sterilized === 'yes' ? 'on' : ''}}"
        data-key="sterilized" data-value="yes" bindtap="onFilter" hover-class="pressed">已绝育</view>
      <block wx:for="{{patternOptions}}" wx:key="value">
        <view class="chip {{filters.pattern === item.value ? 'on' : ''}}"
          data-key="pattern" data-value="{{item.value}}" bindtap="onFilter" hover-class="pressed">{{item.label}}</view>
      </block>
    </view>
  </scroll-view>

  <!-- 猫谱列表（建档入口 = 右下角悬浮按钮，避免与列表头重复） -->
  <block wx:if="{{tab === 'cat'}}">
    <cat-card
      wx:for="{{list}}"
      wx:key="_id"
      cat="{{item}}"
      bind:tap="goDetail"
    />
    <view class="empty" wx:if="{{!loading && !list.length}}">
      <text class="emoji">🐈</text>
      没有符合条件的猫咪
    </view>
  </block>

  <!-- 目击动态 -->
  <block wx:else>
    <view class="card" wx:for="{{sightings}}" wx:key="_id">
      <view class="flex-between">
        <view class="flex">
          <view class="cat-name" wx:if="{{item.catId}}" bindtap="goDetail" data-id="{{item.catId}}" hover-class="pressed">
            {{item.cat ? item.cat.name : '未知'}}
          </view>
          <text class="cat-name muted" wx:else>{{item.catName}}</text>
          <view class="tag warn small" wx:if="{{item.pending}}">待建档</view>
          <view class="tag ok small" wx:if="{{item.feedStatus === 'fed'}}">本人投喂</view>
          <view class="tag info small" wx:if="{{item.feedStatus === 'fedByOther'}}">他人已喂</view>
        </view>
        <text class="small muted">{{item.timeText}}</text>
      </view>
      <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="photo-row" wx:if="{{item.photosSmall.length}}">
        <!-- 展示用缩略图（photosSmall 由 utils/photo.js 生成），点开预览仍是可直连的 https 原图 -->
        <image
          wx:for="{{item.photosSmall}}"
          wx:for-item="p"
          wx:for-index="pi"
          wx:key="*this"
          src="{{p}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          binderror="onSightPhotoErr"
          data-i="{{index}}"
          data-j="{{pi}}"
          data-url="{{item.photosFull[pi]}}"
          data-urls="{{item.photosFull}}"
          bindtap="previewPhoto"
        />
      </view>
      <view class="small muted" style="margin-top:12rpx">
        📍 {{item.locationName || '未记录位置'}} · 上报人 {{item.reporterName}}
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && !sightings.length}}">
      <text class="emoji">📷</text>
      还没有目击记录
    </view>
  </block>

  <!-- 悬浮按钮：建档仅管理员以上；打卡对成员/管理员开放。
       ⚠️ bindtap 必须是静态方法名：WXML 事件绑定在编译期解析，三元表达式
       {{tab === 'cat' ? 'goAdd' : 'goSighting'}} 不会被求值，点击时报
       "does not have a method" 或静默无响应（本页 FAB 主入口曾整个失效）。 -->
  <view class="fab" bindtap="onFabTap"
    wx:if="{{(tab === 'cat' && canAdd) || (tab === 'sighting' && isMember)}}">
    {{tab === 'cat' ? '+ 建档' : '+ 打卡'}}
  </view>

</view>
