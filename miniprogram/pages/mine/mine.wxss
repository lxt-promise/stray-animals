.profile {
  display: flex;
  align-items: center;
}
.profile .avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
/* 头像本体是 <button open-type="chooseAvatar">：必须重置微信 button 的
   默认样式（padding / min-height / line-height / ::after 边框），
   否则内容被顶偏、圆形被裁掉 —— 表现就是「头像显示不全」。 */
.profile .avatar.avatar-btn {
  padding: 0;
  margin: 0 24rpx 0 0;
  min-height: 0;
  line-height: 1;
  border: none;
  background: var(--brand-light);
}
.profile .avatar.avatar-btn::after { border: none; }
.profile .avatar image { width: 100%; height: 100%; }
.p-name { font-size: 34rpx; font-weight: 600; }
.p-role { margin-top: 10rpx; display: flex; align-items: center; gap: 12rpx; }

/* ===== 我的数据（三格统计卡） =====
   wxml 用的是 .stat-card/.num/.lbl，此前从未定义过样式，
   数字贴边、标签错位 —— 这里补齐：等分三格 + 内容居中 + 卡片化。 */
.stat-grid { margin: 16rpx -8rpx 0; }   /* 覆盖全局的 margin:0 -8rpx，与上方资料卡留出间距 */
.stat-card {
  background: var(--card, #fff);
  border: 2rpx solid var(--card-line, rgba(0,0,0,.05));
  border-radius: var(--radius-sm, 16rpx);
  padding: 22rpx 8rpx;
  text-align: center;
}
.stat-card .num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--brand);
}
.stat-card .lbl {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.school-item {
  padding: 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--brand-dark);
  text-align: right;
}

/* 地图范围：两个动作并排（选择中心点 / 保存范围） */
.range-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.range-actions .btn {
  flex: 1;
  margin: 0;
  width: auto;
}

.my-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.my-item:last-child { border-bottom: none; }
.photo-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}
.photo-row image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
  font-size: 30rpx;
}
.menu-item:last-child { border-bottom: none; }
.menu-item .arrow { color: var(--text-weak); font-size: 36rpx; }

.tip {
  padding: 24rpx;
  line-height: 1.7;
  text-align: center;
}

/* ===== 工作台（从底部 tab 迁移至此） ===== */
.wb-stat-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.wb-stat {
  flex: 1;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}
.wb-stat .num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
}
.wb-stat .lbl {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}
.wb-balance {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ok);
  margin-top: 6rpx;
}
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx -8rpx 0;
}
.entry {
  width: 33.33%;
  padding: 8rpx;
}
.entry-inner {
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 22rpx 8rpx;
  text-align: center;
  height: 100%;
}
.entry-inner .ico { font-size: 40rpx; }
.entry-inner .txt {
  font-size: 25rpx;
  font-weight: 600;
  margin-top: 10rpx;
}
.entry-inner .desc {
  font-size: 19rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  transform: scale(.92);
  white-space: nowrap;
}

/* ===== 图鉴进度（对齐预览） ===== */
.progress {
  height: 16rpx;
  background: rgba(146, 88, 32, .08);
  border-radius: 8rpx;
  overflow: hidden;
}
.progress .bar {
  height: 100%;
  background: var(--brand-grad);
  box-shadow: 0 0 20rpx rgba(249, 115, 22, .5);
  border-radius: 8rpx;
  transition: width .4s;
}
.dex-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.dex-item {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  overflow: hidden;
  border: 2rpx solid rgba(249, 115, 22, .25);
}
.dex-item image { width: 100%; height: 100%; }
.dex-item.locked {
  background: rgba(146, 88, 32, .06);
  border-color: var(--card-line);
  color: var(--text-weak);
  opacity: .55;
}
