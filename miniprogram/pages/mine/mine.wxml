<view class="page">

  <!-- 用户信息 -->
  <view class="card profile">
    <view class="profile-glow"></view>
    <button class="avatar avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarView}}" src="{{avatarView}}" mode="aspectFill" />
      <text wx:else>🐱</text>
    </button>
    <view class="p-info">
      <input class="p-name-input" type="nickname" value="{{user.nickName}}" placeholder="点此设置昵称"
        bindblur="onNickName" bindconfirm="onNickName" confirm-type="done" />
      <view class="p-role">
        <!-- 等级称号：贴在头像/昵称旁，一眼能看到自己的段位。
             点击进入「等级与积分」—— 这里刻意只留称号，不放积分/进度，
             否则「我的」页又变成账本页了。 -->
        <view class="tag gold lv-tag" bindtap="goLevelPoints" hover-class="pressed">
          <text>{{wallet.levelText}}</text><text class="lv-arrow">›</text>
        </view>
        <view class="tag {{isSuper ? 'gold' : (isMember ? 'ok' : 'gray')}}">{{isSuper ? '超级管理员' : (isMember ? (isAdmin ? '管理员' : '社团成员') : '爱猫同学')}}</view>
      </view>
      <view class="p-school" wx:if="{{school}}">
        <text class="p-school-dot"></text>
        <text>{{school.name}}</text>
      </view>
    </view>
  </view>
  <view class="edit-hint">点头像换图 · 点昵称可改 · 点等级看积分</view>

  <!-- 我的数据：猫粮值 / 打卡次数 / 图鉴数（三格都可点，各自跳到明细页）
       积分值不在这里显示 —— 它是等级的依据，点上方等级标签才进明细
       版式：图标在左（浅橙圆角方块），右侧竖排「标签 / 数值」 -->
  <view class="stat-grid">
    <view class="item">
      <view class="stat-card" bindtap="goFoodDetail" hover-class="stat-hover">
        <view class="stat-ico">🍚</view>
        <view class="stat-body">
          <view class="lbl">猫粮值<text class="stat-go">›</text></view>
          <view class="num">{{stats.food}}</view>
        </view>
      </view>
    </view>
    <view class="item">
      <view class="stat-card" bindtap="goCatsSighting" hover-class="stat-hover">
        <view class="stat-ico">📷</view>
        <view class="stat-body">
          <view class="lbl">打卡次数<text class="stat-go">›</text></view>
          <view class="num">{{stats.sightingCount}}</view>
        </view>
      </view>
    </view>
    <view class="item">
      <view class="stat-card" bindtap="goDex" hover-class="stat-hover">
        <view class="stat-ico">📖</view>
        <view class="stat-body">
          <!-- 图鉴是「已收集 / 本校总数」，只给 3 看不出还差几只。
               分母单独一层 <text> 才能做小字号：WXML 的 mustache 不支持字符串拼接，
               写 {{seen + '/' + total}} 会被静默忽略成空白。
               total 为 0（未绑定学校 / 本校暂无档案）时不摆假分母，用「—」表示无数据。 -->
          <view class="lbl">图鉴数<text class="stat-go">›</text></view>
          <view class="num" wx:if="{{dexSummary.total}}">{{stats.catSeen}}<text class="num-sub">/{{dexSummary.total}}</text></view>
          <view class="num dim" wx:else>—</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 图鉴进度已挪到独立页面（pages/dex）：这里只留「图鉴收集」入口，
       点进去看进度条与解锁墙。原来在这一页铺 8 格墙，把打卡与菜单挤到很下面。 -->

  <!-- 学校：只做「身份归属」展示 + 换校。
       地图中心 / 地图范围属于学校级配置，已全部迁到「超级管理后台 → 校园管理」，
       普通用户（包括超管）在这里不再看到坐标与缩放 —— 个人页不该有基础设施配置。 -->
  <view class="card mt school-card">
    <view class="card-title">
      我的学校
      <text class="more" wx:if="{{isSuper}}" data-url="/pages/admin/admin" bindtap="go">校园管理 ›</text>
    </view>

    <!-- 已绑定：本校信息（未绑定时走下面的 wx:else —— 必须说清"为什么图鉴是空的"） -->
    <block wx:if="{{school}}">
      <view class="school-hero">
        <view class="school-logo">🏫</view>
        <view class="school-hero-main">
          <view class="school-name">{{school.name}}</view>
          <view class="school-chips">
            <text class="chip solid" wx:if="{{school.campus}}">{{school.campus}}</text>
            <text class="chip" wx:if="{{school.city}}">{{school.city}}</text>
          </view>
        </view>
      </view>
      <view class="school-intro" wx:if="{{school.intro}}">{{school.intro}}</view>
    </block>
    <view wx:else class="school-empty">
      <view class="school-empty-title">还没绑定学校</view>
      <view class="small muted">图鉴、打卡与地图都按学校统计，先选一所本校吧。</view>
    </view>

    <!-- 选校下拉：原生 picker 就是小程序里的下拉框，选中后填理由提交申请（不再即选即绑） -->
    <picker mode="selector" range="{{schoolOptions}}" range-key="label" bindchange="onPickSchool">
      <view class="school-pick" hover-class="pressed">
        <view class="school-pick-left">
          <text class="school-pick-ico">⇄</text>
          <view class="school-pick-txt">
            <view class="school-pick-main">{{school ? '切换学校' : '选择学校'}}</view>
            <!-- 副文案在 JS 里拼好：WXML 的 mustache 对字符串拼接是**静默忽略**的 -->
            <view class="school-pick-sub">{{schoolPickHint}}</view>
          </view>
        </view>
        <text class="school-pick-side">{{schoolPickSide}} ›</text>
      </view>
    </picker>

    <!-- 切换到附近 25km 内无学校：引导去新建（openSchoolPicker 也会弹 toast 并直接展开新建表单） -->
    <view class="small muted mt" wx:if="{{nearbyEmpty}}">
      附近 25km 内暂无学校，点击下方「没有我的学校？申请新建」创建本校。
    </view>

    <!-- 加入已有学校的理由弹窗：选中学校后填理由提交，管理员审核通过才绑定 -->
    <view class="mask" wx:if="{{showJoinForm}}" bindtap="cancelJoinForm">
      <view class="sheet" catchtap="noop">
        <view class="sheet-title">申请加入「{{joinLabel}}」</view>
        <view class="small muted">提交后由管理员审核，通过后才绑定为你的学校。</view>
        <textarea class="reason-input" placeholder="请填写申请理由，如：本校学生 / 教职工 / 经常投喂的志愿者"
          value="{{joinReason}}" bindinput="onJoinReason" maxlength="200" auto-focus />
        <view class="sheet-actions">
          <view class="sheet-btn ghost" bindtap="cancelJoinForm">取消</view>
          <view class="sheet-btn solid" bindtap="submitJoinApply">提交申请</view>
        </view>
      </view>
    </view>

    <!-- 审核中 / 被驳回：状态必须可见，否则用户会以为提交没成功反复提交 -->
    <view class="apply-state small mt" wx:if="{{schoolApply.pending}}">
      ⏳「{{schoolApply.pending.label}}」的{{schoolApply.pending.type === 'join' ? '入校' : '建校'}}申请审核中，通过后会自动绑定。
    </view>
    <view class="apply-state rejected small mt" wx:if="{{schoolApply.rejected}}">
      ✕「{{schoolApply.rejected.label}}」的申请未通过，可修改后重新提交。
    </view>

    <!-- 找不到本校 → 申请新建 -->
    <view class="menu-item school-apply-toggle" bindtap="toggleSchoolForm" hover-class="pressed">
      <text>{{showSchoolForm ? '收起新建申请' : '没有我的学校？申请新建'}}</text>
      <text class="arrow {{showSchoolForm ? 'open' : ''}}">›</text>
    </view>

    <block wx:if="{{showSchoolForm}}">
      <view class="form-item">
        <text class="label">学校名称</text>
        <input placeholder="如：南京大学" value="{{schoolForm.name}}" data-key="name" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">校区</text>
        <input placeholder="如：仙林校区" value="{{schoolForm.campus}}" data-key="campus" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">城市</text>
        <input placeholder="如：南京" value="{{schoolForm.city}}" data-key="city" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">简介</text>
        <input placeholder="一句话介绍" value="{{schoolForm.intro}}" data-key="intro" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">申请理由</text>
        <input placeholder="为何要建这所学校，如：本校有流浪猫待照顾" value="{{schoolForm.reason}}" data-key="reason" bindinput="onInput" />
      </view>
      <button class="btn mt" bindtap="submitSchoolApply">{{isSuper ? '创建并绑定' : '提交审核'}}</button>
      <view class="small muted mt" wx:if="{{!isSuper}}">
        提交后由超级管理员审核，通过前不会创建学校；通过后自动绑定为你的学校。申请需填写理由。
      </view>
    </block>
  </view>

  <!-- 工作台（管理员及以上可见）：从底部 tab 迁移至此 -->
  <view class="card mt" wx:if="{{isAdminPlus}}">
    <view class="card-title" bindtap="toggleWb">
      工作台
      <text class="more">{{wbOpen ? '收起' : '展开'}}</text>
    </view>

    <!-- 折叠态：一行待办概览 -->
    <view class="flex-between" bindtap="toggleWb">
      <text class="small muted">待建档 {{wb.pendingSighting}} · 待抓捕 {{wb.todoTnr}} · 待认领 {{wb.openTask}}</text>
      <text class="small muted">结余 ¥{{wb.balance}}</text>
    </view>

    <block wx:if="{{wbOpen}}">
      <view class="wb-stat-row">
        <view class="wb-stat">
          <view class="num">{{wb.pendingSighting}}</view>
          <view class="lbl">待建档目击</view>
        </view>
        <view class="wb-stat">
          <view class="num">{{wb.todoTnr}}</view>
          <view class="lbl">待抓捕 TNR</view>
        </view>
        <view class="wb-stat">
          <view class="num">{{wb.openTask}}</view>
          <view class="lbl">待认领任务</view>
        </view>
      </view>

      <view class="flex-between" style="margin-top:20rpx">
        <view>
          <view class="small muted">资金结余</view>
          <view class="wb-balance">¥ {{wb.balance}}</view>
        </view>
        <button class="btn btn-ghost btn-sm" data-url="/pages/fund/fund" bindtap="go">收支明细</button>
      </view>

      <view class="entry-grid">
        <view class="entry" data-url="/pages/cat-edit/cat-edit" bindtap="go">
          <view class="entry-inner">
            <view class="ico">🐱</view>
            <view class="txt">新建猫档案</view>
            <view class="desc">手动录入 · 建档</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/tnr/tnr" bindtap="go">
          <view class="entry-inner">
            <view class="ico">✂️</view>
            <view class="txt">TNR 台账</view>
            <view class="desc">抓捕 / 绝育 / 放归</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/task/task" bindtap="go">
          <view class="entry-inner">
            <view class="ico">📅</view>
            <view class="txt">喂猫排班</view>
            <view class="desc">任务发布与认领</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/fund/fund" bindtap="go">
          <view class="entry-inner">
            <view class="ico">💰</view>
            <view class="txt">资金公示</view>
            <view class="desc">收支公开透明</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/member/member" bindtap="go">
          <view class="entry-inner">
            <view class="ico">👥</view>
            <view class="txt">成员管理</view>
            <view class="desc">角色与入社审核</view>
          </view>
        </view>
        <!-- 目击建档入口：cats 是 tabBar 页，navigateTo 会被微信静默拒绝
             （can not navigateTo a tabbar page，表现为「点了没反应」），
             必须走 globalData + switchTab（与首页「我的打卡」同一模式） -->
        <view class="entry" bindtap="goCatsSighting">
          <view class="entry-inner">
            <view class="ico">📷</view>
            <view class="txt">目击建档</view>
            <view class="desc">认领 / 建档</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 入口 -->
  <view class="card mt">
    <!-- 只展示猫粮值的流水；积分总值从上方等级标签进入 -->
    <view class="menu-item" data-url="/pages/points/points?type=food" bindtap="go" hover-class="pressed">
      <view class="mi-ico">🍚</view>
      <text class="mi-txt">猫粮明细</text>
      <text class="arrow">›</text>
    </view>
    <!-- 图鉴收集：进度与解锁墙在独立页面（pages/dex），这里只显示本校的收集数 -->
    <view class="menu-item" bindtap="goDex" hover-class="pressed">
      <view class="mi-ico">📖</view>
      <text class="mi-txt">图鉴收集</text>
      <view class="menu-right">
        <text class="my-count">{{dexSummary.text}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <!-- 我的打卡：从独立卡片迁移为菜单项，点击后才展开下方记录（默认收起，页面更干净） -->
    <view class="menu-item" bindtap="toggleMyCheckin" hover-class="pressed">
      <view class="mi-ico">📷</view>
      <text class="mi-txt">我的打卡</text>
      <view class="menu-right">
        <text class="my-count" wx:if="{{stats.sightingCount}}">共 {{stats.sightingCount}} 次</text>
        <text class="arrow {{myCheckinOpen ? 'open' : ''}}">›</text>
      </view>
    </view>
    <view class="menu-item" data-url="/pages/admin/admin" bindtap="go" wx:if="{{isSuper}}" hover-class="pressed">
      <view class="mi-ico">🛠</view>
      <text class="mi-txt">超级管理后台</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/member/member" bindtap="go" hover-class="pressed">
      <view class="mi-ico">🎫</view>
      <text class="mi-txt">身份与入社申请</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/fund/fund" bindtap="go" wx:if="{{isMember}}" hover-class="pressed">
      <view class="mi-ico">💰</view>
      <text class="mi-txt">资金公示</text>
      <text class="arrow">›</text>
    </view>
    <!-- 规则说明：原来常驻在页面底部，占屏且没人看；收进菜单点击展开 -->
    <view class="menu-item" bindtap="toggleRules" hover-class="pressed">
      <view class="mi-ico">📋</view>
      <text class="mi-txt">规则说明</text>
      <view class="menu-right">
        <text class="my-count">积分 · 猫粮</text>
        <text class="arrow {{rulesOpen ? 'open' : ''}}">›</text>
      </view>
    </view>
    <!-- 意见反馈：视觉层用普通 view（与其他菜单项严格一致），
         button 透明覆盖整行只负责拉起客服会话 -->
    <view class="menu-item">
      <view class="mi-ico">💬</view>
      <text class="mi-txt cb-label">意见反馈</text>
      <text class="arrow">›</text>
      <button class="contact-hit" open-type="contact" session-from="feedback">意见反馈</button>
    </view>
  </view>

  <!-- 规则说明：点击菜单项后展开。文案来自 const.RULES（与等级页共用一份） -->
  <view class="card mt" wx:if="{{rulesOpen}}">
    <view class="card-title">规则说明</view>
    <view class="rule-block" wx:for="{{rules}}" wx:for-item="r" wx:key="title">
      <view class="rule-title">{{r.title}}</view>
      <view class="rule-line" wx:for="{{r.lines}}" wx:for-item="line" wx:for-index="li" wx:key="*this">{{line}}</view>
    </view>
  </view>

  <!-- 我的打卡记录：点击上方「我的打卡」菜单项后展开 -->
  <view class="card mt" wx:if="{{myCheckinOpen}}">
    <view class="card-title">我的打卡</view>
    <block wx:for="{{mySightings}}" wx:key="_id">
      <view class="my-item">
        <view class="flex-between">
          <view class="flex" style="align-items:center;gap:12rpx">
            <view class="bold" wx:if="{{item.catId}}" data-id="{{item.catId}}" bindtap="goCat" hover-class="pressed">{{item.cat.name || '未知'}}</view>
            <text class="bold muted" wx:elif="{{!item.catId}}">{{item.catName}}</text>
            <view class="tag ok small" wx:if="{{item.feedStatus === 'fed'}}">本人投喂</view>
            <view class="tag info small" wx:if="{{item.feedStatus === 'fedByOther'}}">他人已喂</view>
          </view>
          <text class="small muted">{{item.timeText}}</text>
        </view>
        <!-- 结构化标签（合规改造：替代原自由文本 note） -->
        <view class="small muted ellipsis" wx:if="{{item.tagText}}">{{item.tagText}}</view>
        <view class="photo-row" wx:if="{{item.photosSmall.length}}">
          <image wx:for="{{item.photosSmall}}" wx:for-item="p" wx:for-index="pi" wx:key="*this"
            src="{{p}}" mode="aspectFill" lazy-load="{{true}}"
            binderror="onMyPhotoErr" data-i="{{index}}" data-j="{{pi}}"
            data-url="{{item.photosFull[pi]}}" data-urls="{{item.photosFull}}" bindtap="previewPhoto" />
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!mySightings.length}}">
      <text class="emoji">🐾</text>
      还没有打卡记录
    </view>
  </view>

  <!-- 规则说明已收进「规则说明」菜单项（点击展开），页面底部不再常驻 -->

</view>
