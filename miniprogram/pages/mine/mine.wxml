<view class="page">

  <!-- 用户信息 -->
  <view class="card profile">
    <button class="avatar avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill" />
      <text wx:else>🐱</text>
    </button>
    <view class="p-info">
      <input class="p-name-input" type="nickname" value="{{user.nickName}}" placeholder="点此设置昵称"
        bindblur="onNickName" bindconfirm="onNickName" confirm-type="done" />
      <view class="p-role">
        <text class="tag {{isSuper ? 'gold' : (isMember ? 'ok' : 'gray')}}">{{isSuper ? '超级管理员' : (isMember ? (isAdmin ? '管理员' : '社团成员') : '爱猫同学')}}</text>
        <text class="small muted" wx:if="{{school}}">{{school.name}}</text>
      </view>
      <text class="small muted edit-hint">点击头像换图 · 点昵称可改</text>
    </view>
  </view>

  <!-- 我的数据 -->
  <view class="stat-grid">
    <view class="item">
      <view class="stat-card">
        <view class="num">{{stats.points}}</view>
        <view class="lbl">猫粮值</view>
      </view>
    </view>
    <view class="item">
      <view class="stat-card">
        <view class="num">{{stats.sightingCount}}</view>
        <view class="lbl">打卡次数</view>
      </view>
    </view>
    <view class="item">
      <view class="stat-card">
        <view class="num">{{stats.catSeen}}</view>
        <view class="lbl">图鉴收集</view>
      </view>
    </view>
  </view>

  <!-- 图鉴进度（对齐预览：进度条 + 解锁墙） -->
  <view class="card mt" wx:if="{{dex.length}}">
    <view class="card-title">
      图鉴进度
      <text class="more" bindtap="goCats">去猫谱 ›</text>
    </view>
    <view class="flex-between small muted" style="margin-bottom:16rpx">
      <text>已收集 {{stats.catSeen}} / {{dexTotal}}</text>
      <text>{{dexPercent}}%</text>
    </view>
    <view class="progress">
      <view class="bar" style="width: {{dexPercent}}%"></view>
    </view>
    <view class="dex-row">
      <view class="dex-item {{item.unlocked ? '' : 'locked'}}" wx:for="{{dex}}" wx:key="id"
        data-id="{{item.id}}" bindtap="goCat">
        <image wx:if="{{item.avatar && item.unlocked}}" src="{{item.avatar}}" mode="aspectFill" />
        <text wx:elif="{{item.unlocked}}">🐱</text>
        <text wx:else>?</text>
      </view>
    </view>
    <view class="small muted" style="margin-top:16rpx;line-height:1.7">
      每拍到一只没见过的猫，图鉴自动解锁；灰色的是还没遇到的同学。
    </view>
  </view>

  <!-- 学校设置 -->
  <view class="card mt">
    <view class="card-title">
      学校
      <text class="more" bindtap="toggleSchoolForm">{{showSchoolForm ? '收起' : '创建 / 切换'}}</text>
    </view>
    <view wx:if="{{!showSchoolForm && school}}">
      <view class="row"><text class="label">当前</text><text class="value">{{school.name}} {{school.campus}}</text></view>
      <view class="row" wx:if="{{school.intro}}"><text class="label">简介</text><text class="value">{{school.intro}}</text></view>
      <view class="row">
        <text class="label">地图中心</text>
        <text class="value">{{school.center ? '已设置' : '未设置（用默认范围）'}}</text>
      </view>
      <block wx:if="{{isSuper}}">
        <view class="form-item">
          <text class="label">地图范围</text>
          <picker mode="selector" range="{{scaleOptions}}" range-key="label"
            value="{{scaleIndex}}" bindchange="onScaleChange">
            <view class="picker-value">{{scaleOptions[scaleIndex].label}}</view>
          </picker>
        </view>
        <view class="range-actions">
          <button class="btn btn-ghost btn-sm" bindtap="setSchoolCenter">选择地图中心点</button>
          <button class="btn btn-sm" bindtap="saveScale">保存范围</button>
        </view>
        <view class="small muted" style="margin-top:12rpx;line-height:1.7">
          「选择地图中心点」会同时保存中心与当前范围；只想调整大小就改上面的级别后点「保存范围」。
          保存后地图页只会展示这块校园区域内的猫咪点位。
        </view>
        <view class="small muted" style="margin-top:8rpx;line-height:1.7">
          当前：中心 {{school.center ? school.center.lat : '未设置'}}<text wx:if="{{school.center}}">, {{school.center.lng}}</text>
          · 缩放 {{school.scale || '未设置'}}
        </view>
      </block>
    </view>
    <view wx:if="{{!showSchoolForm && !school}}" class="small muted">未绑定学校</view>

    <block wx:if="{{showSchoolForm}}">
      <view class="form-item">
        <text class="label">学校名称</text>
        <input placeholder="如：南京大学" value="{{schoolForm.name}}" data-key="name" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">校区</text>
        <input placeholder="如：仙林校区" value="{{schoolForm.campus}}" data-key="campus" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">城市</text>
        <input placeholder="如：南京" value="{{schoolForm.city}}" data-key="city" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">简介</text>
        <input placeholder="一句话介绍" value="{{schoolForm.intro}}" data-key="intro" bindinput="onInput" />
      </view>
      <button class="btn mt" bindtap="createSchool" wx:if="{{isSuper}}">创建并绑定</button>
      <view class="small muted mt" wx:else>仅超级管理员可创建学校</view>

      <view class="mt" wx:if="{{schools.length}}">
        <view class="bold small" style="margin-bottom:12rpx">已有学校</view>
        <view class="school-item" wx:for="{{schools}}" wx:key="_id" data-id="{{item._id}}" bindtap="bindSchool">
          {{item.name}} {{item.campus}}
        </view>
      </view>
    </block>
  </view>

  <!-- 我的打卡 -->
  <view class="card mt">
    <view class="card-title">我的打卡</view>
    <block wx:for="{{mySightings}}" wx:key="_id">
      <view class="my-item">
        <view class="flex-between">
          <text class="bold" wx:if="{{item.catId}}" data-id="{{item.catId}}" bindtap="goCat">{{item.cat.name || '未知'}}</text>
          <text class="bold muted" wx:else>{{item.catName}}</text>
          <text class="small muted">{{item.timeText}}</text>
        </view>
        <view class="small muted ellipsis" wx:if="{{item.note}}">{{item.note}}</view>
        <view class="photo-row" wx:if="{{item.photos.length}}">
          <image wx:for="{{item.photos}}" wx:for-item="p" wx:key="*this" src="{{p}}" mode="aspectFill"
            data-url="{{p}}" data-urls="{{item.photos}}" bindtap="previewPhoto" />
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!mySightings.length}}">
      <text class="emoji">🐾</text>
      还没有打卡记录
    </view>
  </view>

  <!-- 工作台（管理员及以上可见）：从底部 tab 迁移至此 -->
  <view class="card mt" wx:if="{{isAdminPlus}}">
    <view class="card-title" bindtap="toggleWb">
      工作台
      <text class="more">{{wbOpen ? '收起' : '展开'}}</text>
    </view>

    <!-- 折叠态：一行待办概览 -->
    <view class="flex-between" bindtap="toggleWb">
      <text class="small muted">待建档 {{wb.pendingSighting}} · 待抓捕 {{wb.todoTnr}} · 待认领 {{wb.openTask}}</text>
      <text class="small muted">结余 ¥{{wb.balance}}</text>
    </view>

    <block wx:if="{{wbOpen}}">
      <view class="wb-stat-row">
        <view class="wb-stat">
          <view class="num">{{wb.pendingSighting}}</view>
          <view class="lbl">待建档目击</view>
        </view>
        <view class="wb-stat">
          <view class="num">{{wb.todoTnr}}</view>
          <view class="lbl">待抓捕 TNR</view>
        </view>
        <view class="wb-stat">
          <view class="num">{{wb.openTask}}</view>
          <view class="lbl">待认领任务</view>
        </view>
      </view>

      <view class="flex-between" style="margin-top:20rpx">
        <view>
          <view class="small muted">资金结余</view>
          <view class="wb-balance">¥ {{wb.balance}}</view>
        </view>
        <button class="btn btn-ghost btn-sm" data-url="/pages/fund/fund" bindtap="go">收支明细</button>
      </view>

      <view class="entry-grid">
        <view class="entry" data-url="/pages/cat-edit/cat-edit" bindtap="go">
          <view class="entry-inner">
            <view class="ico">🐱</view>
            <view class="txt">新建猫档案</view>
            <view class="desc">手动录入 · 建档</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/tnr/tnr" bindtap="go">
          <view class="entry-inner">
            <view class="ico">✂️</view>
            <view class="txt">TNR 台账</view>
            <view class="desc">抓捕 / 绝育 / 放归</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/task/task" bindtap="go">
          <view class="entry-inner">
            <view class="ico">📅</view>
            <view class="txt">喂猫排班</view>
            <view class="desc">任务发布与认领</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/fund/fund" bindtap="go">
          <view class="entry-inner">
            <view class="ico">💰</view>
            <view class="txt">资金公示</view>
            <view class="desc">捐赠与支出透明</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/member/member" bindtap="go">
          <view class="entry-inner">
            <view class="ico">👥</view>
            <view class="txt">成员管理</view>
            <view class="desc">角色与入社审核</view>
          </view>
        </view>
        <view class="entry" data-url="/pages/cats/cats?tab=sighting" bindtap="go">
          <view class="entry-inner">
            <view class="ico">📷</view>
            <view class="txt">目击建档</view>
            <view class="desc">认领 / 建档</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 入口 -->
  <view class="card mt">
    <view class="menu-item" data-url="/pages/points/points" bindtap="go">
      <text>猫粮明细</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/admin/admin" bindtap="go" wx:if="{{isSuper}}">
      <text>超级管理后台</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/member/member" bindtap="go">
      <text>身份与入社申请</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/fund/fund" bindtap="go" wx:if="{{isMember}}">
      <text>资金公示</text><text class="arrow">›</text>
    </view>
  </view>

  <view class="tip small muted">
    猫粮值规则：目击打卡 +10，上报新猫 +30，首次遇见某只猫 +20，参与 TNR 记录 +50。每日打卡积分上限 60，防止刷分。
  </view>

</view>
