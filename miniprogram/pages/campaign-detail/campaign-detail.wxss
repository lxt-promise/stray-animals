/* ===================== 咪咪筹详情 ===================== */

.cd-page { padding-bottom: 60rpx; }

/* ---------- 头部进度卡 ---------- */
.cd-hero {
  position: relative;
  padding: 30rpx 28rpx 26rpx;
  border-radius: var(--radius);
  background: linear-gradient(160deg, #FFFFFF 0%, #FFF6EA 60%, #FFEBD2 100%);
  border: 2rpx solid rgba(249, 115, 22, .16);
  box-shadow: var(--shadow);
  margin-bottom: 20rpx;
}
.cd-head { display: flex; align-items: flex-start; }
.cd-ava {
  width: 136rpx; height: 136rpx; flex: none;
  border-radius: 28rpx; background: var(--brand-light);
}
.cd-ava.ph {
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
}
.cd-head-main { flex: 1; margin-left: 22rpx; min-width: 0; }
.cd-title { font-size: 33rpx; font-weight: 700; line-height: 1.4; }
.cd-tags { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.cd-tag {
  font-size: 20rpx; padding: 5rpx 14rpx; border-radius: 999rpx;
  margin: 0 10rpx 8rpx 0; line-height: 1.6;
}
.cd-tag.kind { background: rgba(249, 115, 22, .14); color: var(--brand-dark); }
.cd-tag.ghost { background: rgba(255, 255, 255, .9); color: var(--text-sub); }
.cd-tag.days { background: rgba(47, 134, 214, .1); color: var(--info); }
.cd-tag.warn { background: rgba(224, 72, 60, .12); color: var(--warn); }

.cd-progress {
  margin-top: 26rpx; height: 20rpx; border-radius: 999rpx;
  background: #F2E5D5; overflow: hidden;
}
.cd-bar {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #FBBF24 0%, #F97316 100%);
  transition: width .5s ease;
}
.cd-nums {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-top: 16rpx;
}
.cd-raised { font-size: 44rpx; font-weight: 700; color: var(--brand-dark); }
.cd-goal { font-size: 23rpx; color: var(--text-weak); margin-left: 12rpx; }
.cd-pct { font-size: 26rpx; font-weight: 600; color: var(--brand); }

.cd-stats {
  display: flex; margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(146, 88, 32, .12);
}
.cd-stat { flex: 1; text-align: center; }
.cs-num { font-size: 30rpx; font-weight: 600; }
.cs-label { font-size: 21rpx; color: var(--text-weak); margin-top: 4rpx; }

.cd-closed {
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(146, 88, 32, .06);
  color: var(--text-sub);
  font-size: 23rpx;
}

/* ---------- 故事 ---------- */
.cd-story {
  font-size: 28rpx; line-height: 1.85; color: var(--text);
  white-space: pre-wrap; word-break: break-all;
}
.cd-meta-row {
  display: flex; align-items: center;
  margin-top: 18rpx; padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
  font-size: 25rpx;
}
.cmr-label { width: 140rpx; flex: none; color: var(--text-weak); }
.cmr-value { flex: 1; color: var(--text-sub); }
.cmr-value.link { color: var(--brand-dark); }

/* ---------- 材料 ---------- */
.cd-verified {
  font-size: 21rpx; font-weight: 500;
  padding: 4rpx 14rpx; border-radius: 999rpx;
  background: rgba(47, 163, 107, .12); color: var(--ok);
}
.cd-mats { display: flex; flex-wrap: wrap; }
.cd-mat {
  position: relative;
  width: 200rpx; height: 200rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: #F6F0E8;
}
.cd-mat-img { width: 100%; height: 100%; }
.cd-mat-label {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 22rpx 10rpx 8rpx;
  font-size: 18rpx; color: #fff;
  background: linear-gradient(0deg, rgba(0, 0, 0, .6), rgba(0, 0, 0, 0));
}
.cd-hidden { margin-top: 6rpx; line-height: 1.6; }

/* ---------- 进展时间线 ---------- */
.cd-tl { position: relative; padding-left: 30rpx; }
.cd-tl::before {
  content: ''; position: absolute; left: 8rpx; top: 12rpx; bottom: 12rpx;
  width: 2rpx; background: rgba(249, 115, 22, .2);
}
.cd-tl + .cd-tl { margin-top: 26rpx; }
.tl-dot {
  position: absolute; left: 0; top: 10rpx;
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 6rpx rgba(249, 115, 22, .14);
}
.tl-body { padding-left: 8rpx; }
.tl-text { font-size: 27rpx; line-height: 1.7; }
.tl-imgs { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.tl-img {
  width: 170rpx; height: 170rpx; border-radius: 16rpx;
  margin: 0 12rpx 12rpx 0; background: #F6F0E8;
}
.tl-time { margin-top: 8rpx; }

/* ---------- 支出 ---------- */
.cd-exp { padding: 16rpx 0; border-bottom: 2rpx solid var(--line); }
.cd-exp:last-child { border-bottom: none; }
.cd-exp-amt { color: var(--warn); font-weight: 600; }
.cd-proofs { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.cd-proof {
  width: 130rpx; height: 130rpx; border-radius: 14rpx;
  margin: 0 12rpx 12rpx 0; background: #F6F0E8;
}

/* ---------- 爱心记录 ---------- */
.cd-donor {
  display: flex; align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.cd-donor:last-child { border-bottom: none; }
.cd-donor-ava {
  width: 56rpx; height: 56rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: var(--brand-light); color: var(--brand-dark);
  font-size: 24rpx; font-weight: 600;
}
.cd-donor-name { flex: 1; margin-left: 16rpx; font-size: 26rpx; }
.cd-donor-amt { color: var(--ok); font-weight: 600; font-size: 26rpx; }

/* ---------- 发起人 ---------- */
.cd-owner { display: flex; align-items: center; }
.cd-owner-ava {
  width: 72rpx; height: 72rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: var(--brand-grad); color: #fff; font-size: 28rpx; font-weight: 600;
}
.cd-owner-main { flex: 1; margin-left: 18rpx; min-width: 0; }
.cd-owner-main .small { margin-top: 4rpx; }
.cd-report {
  flex: none; font-size: 22rpx; color: var(--text-weak);
  padding: 8rpx 18rpx; border-radius: 999rpx;
  border: 2rpx solid var(--line);
}
.cd-owner-tip { margin-top: 18rpx; line-height: 1.7; }

/* ---------- 管理操作 ---------- */
.cd-admin {
  display: flex; flex-wrap: wrap; margin-top: 24rpx;
}
.cda-btn {
  padding: 16rpx 30rpx; margin: 0 14rpx 14rpx 0;
  border-radius: 999rpx; font-size: 25rpx;
  background: #fff; border: 2rpx solid var(--line);
  color: var(--text-sub);
}
.cda-btn.danger { color: var(--warn); border-color: rgba(224, 72, 60, .25); }

.cd-bottom-space { height: 140rpx; }

/* ---------- 底部固定条 ---------- */
.cd-bar-fixed {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .96);
  border-top: 2rpx solid var(--line);
  box-shadow: 0 -6rpx 20rpx rgba(146, 88, 32, .06);
  z-index: 50;
}
.cbf-btn {
  height: 86rpx; line-height: 86rpx; text-align: center;
  border-radius: 999rpx; font-size: 29rpx; font-weight: 600;
}
.cbf-btn.ghost {
  width: 176rpx; flex: none; margin-right: 18rpx;
  background: #F7F2EB; color: var(--text-sub);
}
.cbf-btn.main {
  flex: 1; background: var(--brand-grad); color: #fff;
  box-shadow: var(--glow);
}
.cbf-btn.disabled {
  flex: 1; background: #F0EAE2; color: var(--text-weak); font-weight: 400;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(30, 15, 5, .45);
  z-index: 90;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  max-height: 84vh;
  display: flex; flex-direction: column;
}
.sheet-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 22rpx; }
.amt-input {
  height: 110rpx; text-align: center; font-size: 56rpx; font-weight: 700;
  border-bottom: 3rpx solid var(--brand); margin-bottom: 22rpx;
}
.quick { display: flex; margin-bottom: 22rpx; }
.quick-item {
  flex: 1; text-align: center; padding: 18rpx 0;
  margin-right: 14rpx; border-radius: 16rpx;
  background: #FFF6EA; color: var(--brand-dark);
  font-size: 28rpx; font-weight: 600;
}
.quick-item:last-child { margin-right: 0; }
.pay-note { line-height: 1.6; margin-bottom: 20rpx; text-align: center; }
.btn-donate {
  height: 92rpx; line-height: 92rpx; border-radius: 999rpx;
  background: var(--brand-grad); color: #fff; font-size: 31rpx; font-weight: 600;
  box-shadow: var(--glow);
}
.btn-donate::after { border: none; }
.sheet-tip { margin-top: 16rpx; text-align: center; line-height: 1.5; }

.donor-list { max-height: 50vh; margin-bottom: 16rpx; }
.donor { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid var(--line); }
.donor-name { flex: 1; font-size: 27rpx; }
.donor-amt { color: var(--ok); font-weight: 600; margin-right: 16rpx; }
.donor-date { flex: none; }

.btn-ghost {
  height: 82rpx; line-height: 82rpx; border-radius: 999rpx;
  background: #F7F2EB; color: var(--text-sub); font-size: 28rpx;
}
.btn-ghost::after { border: none; }

.rv-info { text-align: center; margin-bottom: 10rpx; line-height: 1.6; }
.rv-contact { text-align: center; margin-bottom: 10rpx; color: var(--text-sub); }
.rv-note {
  width: 100%; min-height: 150rpx;
  padding: 18rpx; margin: 16rpx 0 20rpx;
  border-radius: var(--radius-sm);
  background: #FFFDFA; border: 2rpx solid var(--line);
  font-size: 27rpx; line-height: 1.6;
}
.rv-actions { display: flex; margin-bottom: 16rpx; }
.rv-btn {
  flex: 1; height: 88rpx; line-height: 88rpx; border-radius: 999rpx;
  font-size: 29rpx; font-weight: 600;
}
.rv-btn::after { border: none; }
.rv-btn.reject { margin-right: 16rpx; background: #FDECEA; color: var(--warn); }
.rv-btn.pass { background: var(--brand-grad); color: #fff; }

.cd-back {
  display: inline-block; margin-top: 26rpx;
  padding: 14rpx 48rpx; border-radius: 999rpx;
  background: var(--brand-light); color: var(--brand-dark); font-size: 26rpx;
}
