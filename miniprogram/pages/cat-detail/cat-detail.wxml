<view class="page" wx:if="{{cat}}">

  <!-- 头部 -->
  <view class="detail-hero">
    <image class="hero-img" wx:if="{{cat.avatar}}" src="{{cat.avatar}}" mode="aspectFill"
           binderror="onHeroError" />
    <view class="hero-ph" wx:else>🐱</view>
    <view class="hero-mask">
      <view class="hero-name">{{cat.name}}</view>
      <view class="hero-alias small" wx:if="{{cat.alias}}">又名 {{cat.alias}}</view>
    </view>
  </view>

  <view class="tag-line">
    <view class="tag {{statusLabel === '在校' ? 'ok' : ''}}">{{statusLabel}}</view>
    <view class="tag purple">{{patternLabel}}</view>
    <view class="tag" wx:if="{{rarityItem}}">{{rarityItem.label}}</view>
    <view class="tag {{cat.sterilized === 'yes' ? 'ok' : 'warn'}}">{{sterLabel}}</view>
  </view>

  <!-- 记录概览。
       ⚠️ 不再展示「入库照数量」（2026-10-17 用户要求）：那是后台维护特征库时的概念，
       对普通用户没有意义，而且它统计的是**档案照张数**，不是「特征库里真实有几条向量」，
       两者口径对不上时（例如补库失败）反而误导。
       ⚠️ 也不展示旧的置信度圆环与说明文案（2026-10-15 用户要求）。 -->
  <view class="card card-glow mt">
    <view class="card-title">档案概览</view>
    <view class="small muted">
      最近被记录：{{sightings[0] ? sightings[0].timeText : '暂无'}} · 累计 {{cat.sightingCount || 0}} 次目击<text wx:if="{{lastFedText}}"> · 最近投喂 {{lastFedText}}（{{cat.lastFedBy}}）</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card mt">
    <view class="card-title">档案</view>
    <view class="row"><text class="label">性别</text><text class="value">{{cat.sex === 'male' ? '公' : (cat.sex === 'female' ? '母' : '未知')}}</text></view>
    <view class="row"><text class="label">花色</text><text class="value">{{patternLabel}}<text wx:if="{{cat.colorNote}}"> · {{cat.colorNote}}</text></text></view>
    <view class="row"><text class="label">健康</text><text class="value">{{healthLabel}}</text></view>
    <view class="row" wx:if="{{cat.earMark}}"><text class="label">耳标</text><text class="value">{{cat.earMark}}</text></view>
    <view class="row" wx:if="{{cat.birthday}}"><text class="label">出生</text><text class="value">{{cat.birthday}}</text></view>
    <view class="row" wx:if="{{cat.location && cat.location.name}}">
      <text class="label">常驻点</text>
      <view class="value" bindtap="viewOnMap" hover-class="pressed">{{cat.location.name}} <text class="small muted">（查看地图）</text></view>
    </view>
    <view class="row" wx:if="{{cat.characters.length}}">
      <text class="label">性格</text>
      <view class="value">
        <view class="tag gray" wx:for="{{cat.characters}}" wx:key="*this">{{item}}</view>
      </view>
    </view>
    <view class="row" wx:if="{{cat.note}}"><text class="label">简介</text><text class="value">{{cat.note}}</text></view>
    <view class="row" wx:if="{{canEdit && cat.internalNote}}">
      <text class="label">内部备注</text><text class="value">{{cat.internalNote}}</text>
    </view>
  </view>

  <!-- 相册 -->
  <view class="card mt" wx:if="{{cat.photosSmall.length}}">
    <view class="card-title" bindlongpress="albumDebug">相册</view>
    <view class="photo-grid">
      <!-- 预览不再走 wx.previewImage（它加载失败只给一片黑、连 fail 都不回调），
           改成页面内全屏 <image>，与格子同一条渲染链路。 -->
      <view class="photo-cell" wx:for="{{cat.photosSmall}}" wx:for-index="pi"
            bindtap="previewPhoto" data-i="{{pi}}">
        <image wx:if="{{item}}" src="{{item}}" mode="aspectFill" lazy-load="{{true}}"
          binderror="onAlbumErr" data-i="{{pi}}" />
        <view wx:else class="photo-bad">
          <text>照片失效</text>
          <text class="photo-bad-sub">请重新上传</text>
        </view>
      </view>
    </view>
  </view>

  <!-- TNR 记录（仅成员） -->
  <view class="card mt" wx:if="{{canEdit && tnr.length}}">
    <view class="card-title">TNR 记录</view>
    <view class="tnr-item" wx:for="{{tnr}}" wx:key="_id">
      <view class="flex-between">
        <text class="bold small">{{item.status}}</text>
        <text class="small muted">{{item.surgeryDate || item.trapDate || ''}}</text>
      </view>
      <view class="small muted" wx:if="{{item.hospital}}">{{item.hospital}}<text wx:if="{{item.cost}}"> · ¥{{item.cost}}</text></view>
    </view>
  </view>

  <!-- 目击时间线 -->
  <view class="card mt">
    <view class="card-title">
      目击记录
      <text class="more">{{sightings.length}} 条</text>
    </view>
    <view class="tl-item" wx:for="{{sightings}}" wx:for-index="si" wx:key="_id">
      <view class="tl-dot"></view>
      <view class="tl-body">
        <view class="flex-between">
          <view class="flex" style="align-items:center;gap:12rpx">
            <text class="small bold">{{item.reporterName || '匿名'}}</text>
            <view class="tag ok small" wx:if="{{item.feedStatus === 'fed'}}">本人投喂</view>
            <view class="tag info small" wx:if="{{item.feedStatus === 'fedByOther'}}">他人已喂</view>
          </view>
          <text class="small muted">{{item.timeText}}</text>
        </view>
        <view class="small muted" wx:if="{{item.locationName}}">📍 {{item.locationName}}</view>
        <!-- 结构化标签（合规改造：替代原自由文本 note） -->
        <view class="note small" wx:if="{{item.tagText}}">{{item.tagText}}</view>
        <view class="photo-row" wx:if="{{item.photosSmall.length}}">
          <image wx:for="{{item.photosSmall}}" wx:for-item="p" wx:for-index="pi" wx:key="*this"
            src="{{p}}" mode="aspectFill" lazy-load="{{true}}"
            binderror="onSightErr" data-i="{{si}}" data-j="{{pi}}"
            bindtap="previewSightPhoto" />
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!sightings.length}}">
      <text class="emoji">👀</text>
      还没有人记录过它
    </view>
  </view>

  <!-- 超管专属：删除档案。
       单独一张卡而不是塞进底部操作栏：底部两个按钮已经是「记录目击 / 编辑档案」，
       塞第三个会把主操作挤小；删除本身也不该和日常操作挨在一起。
       二次确认在 removeCat() 里做，确认文案写明「什么会消失、什么会保留」。 -->
  <view class="card mt danger-zone" wx:if="{{isSuper}}">
    <view class="card-title">管理员操作</view>
    <view class="small muted danger-hint">
      删除后档案、照片与识别特征一并移除，且无法恢复；已有目击记录会保留为历史。
    </view>
    <button class="btn btn-danger btn-block" bindtap="removeCat"
            loading="{{removing}}" disabled="{{removing}}">删除猫档案</button>
  </view>

  <!-- 底部操作 -->
  <view class="footer-bar">
    <button class="btn btn-plain" style="flex:1" bindtap="goSighting">记录目击</button>
    <button class="btn" style="flex:1" wx:if="{{canEdit}}" bindtap="goEdit">编辑档案</button>
  </view>

  <!-- 全屏查看：铺满屏幕的 <image>，点空白关闭、点图片不关、左右滑切换 -->
  <view class="viewer" wx:if="{{viewer.on}}" catchtap="closeViewer"
        catchtouchstart="onViewerTouchStart" catchtouchend="onViewerTouchEnd">
    <view class="viewer-count" wx:if="{{viewer.total > 1}}">{{viewer.no}} / {{viewer.total}}</view>
    <image wx:if="{{viewer.cur && !viewer.bad}}" class="viewer-img" src="{{viewer.cur}}"
      mode="aspectFit" binderror="onViewerErr" catchtap="noop" />
    <view class="viewer-tip" wx:elif="{{viewer.bad}}">照片无法显示，可能已被删除</view>
    <view class="viewer-tip" wx:else>加载中…</view>
  </view>

</view>
