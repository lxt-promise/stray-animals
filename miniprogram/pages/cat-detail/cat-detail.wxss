.detail-hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--brand-light);
}
.hero-img { width: 100%; height: 100%; }
.hero-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
}
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 28rpx 24rpx;
  background: linear-gradient(transparent, rgba(146, 88, 32, .18));
  color: #fff;
}
.hero-name { font-size: 44rpx; font-weight: 700; }
.hero-alias { opacity: .85; margin-top: 4rpx; }

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
/* 格子改成包裹层：图坏了要显示「照片失效」，不能变成个空白洞
   （空白洞会被当成「相册里没有这张」，2026-10-24 现场误判） */
.photo-cell {
  width: 210rpx;
  height: 210rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.photo-cell image {
  width: 100%;
  height: 100%;
  display: block;
}
.photo-bad {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f4f5f7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9aa0a6;
  font-size: 24rpx;
}
.photo-bad-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #c2c6cc;
}

/* 全屏查看器 */
.viewer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.viewer-img {
  width: 100%;
  height: 100%;
}
.viewer-count {
  position: absolute;
  top: 90rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  z-index: 2;
}
.viewer-tip {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

.tnr-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.tnr-item:last-child { border-bottom: none; }

.tl-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.tl-item:last-child { border-bottom: none; }
.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  margin: 10rpx 20rpx 0 0;
  flex-shrink: 0;
}
.tl-body { flex: 1; min-width: 0; }
.tl-body .note { margin-top: 8rpx; line-height: 1.6; }
.photo-row {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}
.photo-row image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

/* ===== 管理员操作（超管删除档案） =====
   不用纯红：暖色系里纯红看起来像「出错了」，而删除是一个用户主动选择的操作。
   危险感交给「永久删除」的文案 + 深橙描边承担，按钮本身保持克制（浅底、无光晕）。 */
.danger-zone { border-color: rgba(194, 65, 12, .2); }
.danger-hint { line-height: 1.7; margin-bottom: 18rpx; }
.btn.btn-danger {
  height: 82rpx;
  line-height: 82rpx;
  font-size: 28rpx;
  background: rgba(194, 65, 12, .06);
  color: var(--brand-dark);
  border: 2rpx solid rgba(194, 65, 12, .3);
  box-shadow: none;
}
