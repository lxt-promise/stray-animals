<view class="page rec-page">

  <!-- 模式切换 -->
  <view class="mode-tabs">
    <view class="mt {{mode === 'image' ? 'on' : ''}}" data-mode="image" bindtap="switchMode">图片识别</view>
    <view class="mt {{mode === 'video' ? 'on' : ''}}" data-mode="video" bindtap="switchMode">视频识别</view>
  </view>

  <!-- 计费条：本次花多少、还剩几次，选素材之前就要看得见 -->
  <view class="bill-bar">
    <text class="bill-hint">{{wallet.hint}}</text>
    <text class="bill-food">猫粮 {{wallet.food}}</text>
  </view>

  <!-- 取景区 -->
  <view class="viewport {{stage === 'working' ? 'scanning' : ''}}" bindtap="choose">
    <view class="grid-layer"></view>

    <!-- 未选择：占位 -->
    <view class="vp-empty" wx:if="{{stage === 'idle'}}">
      <view class="vp-ico">{{mode === 'video' ? '🎬' : '📸'}}</view>
      <view class="vp-title">{{mode === 'video' ? '上传一段视频' : '拍一张猫的照片'}}</view>
      <view class="vp-tip small muted">
        {{mode === 'video' ? '支持 15 秒内短视频，系统会抽取关键帧识别' : '支持拍照或从相册选择，正脸 / 侧身均可'}}
      </view>
      <view class="vp-btn">{{mode === 'video' ? '选择视频' : '开始识别'}}</view>
    </view>

    <!-- 已选择：预览 -->
    <block wx:if="{{stage !== 'idle'}}">
      <image wx:if="{{mode === 'image'}}" class="vp-media" src="{{localPath}}" mode="aspectFill" />
      <video wx:else class="vp-media" src="{{localPath}}" object-fit="cover" muted="{{true}}" autoplay="{{true}}" loop="{{true}}" show-play-btn="{{false}}" controls="{{false}}" enable-progress-gesture="{{false}}" />
      <view class="scan-line" wx:if="{{stage === 'working'}}"></view>
      <view class="corner tl"></view>
      <view class="corner tr"></view>
      <view class="corner bl"></view>
      <view class="corner br"></view>
    </block>
  </view>

  <!-- 分析中 -->
  <view class="card working-card" wx:if="{{stage === 'working'}}">
    <view class="flex-between">
      <view class="bold">识别进行中</view>
      <view class="mono small" style="color:var(--brand)">{{progress}}%</view>
    </view>
    <view class="progress mt">
      <view class="bar" style="width: {{progress}}%"></view>
    </view>
    <view class="small muted" style="margin-top:16rpx">{{stageText}}</view>
  </view>

  <!-- 结果 -->
  <block wx:if="{{stage === 'done' && !error && result}}">
    <!-- 降级：没有可信特征。
         必须与「识别完了但没匹配上」区分开 —— 那是"库里没有它"，
         这是"这次根本没识别出东西"，两者的下一步动作不一样。 -->
    <view class="card" wx:if="{{result.degraded}}">
      <view class="text-center" style="padding:26rpx 0">
        <view style="font-size:70rpx">📡</view>
        <view class="bold mt">识别服务暂时不可用</view>
        <view class="small muted" style="margin-top:12rpx;line-height:1.7">
          这次没能提取出可靠特征，所以不给你猜一个结果。稍后重试，或直接新建档案。
        </view>
      </view>
    </view>

    <!-- 特征摘要（合规：不展示占位引擎说明与 request_id 等内部信息） -->
    <view class="card card-glow" wx:if="{{!result.degraded && result.features.tags.length}}">
      <view class="card-title">
        识别特征
        <text class="more mono">{{result.latency}}ms</text>
      </view>
      <view class="feat-row">
        <block wx:for="{{result.features.tags}}" wx:key="k">
          <view class="feat">
            <view class="fk small muted">{{item.k}}</view>
            <view class="fv">{{item.v}}</view>
          </view>
        </block>
      </view>
      <!-- 毛色/花纹现在恒可用（服务端有本地色域分析兜底），判不出来时才给原因。
           有属性就什么都不显示 —— 正常结果下面挂一句解释反而是噪音。 -->
      <view class="small muted mt" wx:if="{{result.attrHint}}">{{result.attrHint}}</view>
    </view>

    <!-- 候选列表 -->
    <view class="card" wx:if="{{!result.degraded && result.candidates.length}}">      <view class="card-title">
        匹配候选
        <text class="more">共 {{result.candidates.length}} 只</text>
      </view>
      <block wx:for="{{result.candidates}}" wx:key="catId">
        <view class="cand" bindtap="goCat" data-id="{{item.catId}}">
          <view class="cand-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"
                   lazy-load="{{true}}" data-i="{{index}}" binderror="onCandAvatarErr" />
            <text wx:else>🐱</text>
          </view>
          <view class="cand-main">
            <view class="flex-between">
              <view class="cand-name bold">{{item.name}}</view>
              <!-- 分数配色跟着「校准后」的量级走：同猫不同照片典型 50~70 分，
                   沿用旧的 80/60 门槛会让一次正确的匹配整行发灰。 -->
              <view class="score mono" style="color:{{item.score >= 70 ? 'var(--brand)' : (item.score >= 45 ? 'var(--gold)' : 'var(--text-sub)')}}">
                {{item.score}}%
              </view>
            </view>
            <view class="score-bar">
              <view class="sb-fill" style="width: {{item.score}}%"></view>
            </view>
            <view class="small muted">{{item.reason}}</view>
          </view>
          <view class="cand-arrow">›</view>
        </view>
      </block>
      <!-- 特征库太小：库里只有 1~2 只猫时，"Top1" 没有比较对象，
           它只是唯一那个，不代表像。 -->
      <view class="notice small mt" wx:if="{{result.indexedTotal >= 0 && result.indexedTotal < 3}}">
        ⓘ 特征库目前只有 {{result.indexedTotal}} 只猫的特征，没有可比较的对象，结果参考价值有限。
      </view>
      <view class="notice small mt" wx:if="{{result.lowConfidence}}">
        ⓘ 匹配置信度偏低（低于 {{result.threshold}}%），上面的排序仅供参考，
        以「识别特征」卡里的画面特征为准。
      </view>
    </view>

    <!-- 查询图质量不足：候选为空是**设计如此**（服务端质量门控，见 server
         engine._quality）。必须把「为什么没有候选」和「该怎么做」一起说清 ——
         只显示空白会被理解成"功能坏了"或"库里没有猫"，而真相是照片看不清。
         2026-10-26 现场：夜间白猫占画面 5%，不拦的话会给出「胖橘 83%」这种
         一眼假的候选，用户照着点确认就把错样本写进了特征库。 -->
    <view class="card" wx:if="{{!result.degraded && qualityBlocked}}">
      <view class="card-title">这张照片没法比对</view>
      <view class="small muted">{{qualityReason || '照片里的猫咪占比太小或不够清晰。'}}</view>
      <view class="notice small mt">
        ⓘ 比对需要足够的毛发细节。靠近一点拍、让猫占满画面大半，并在光线充足时拍摄，
        识别结果会可靠得多。这次不会给出匹配候选，是为了避免把错误的猫指给你。
      </view>
    </view>

    <!-- 人工确认：人机协同闭环。
         ⚠️ 文案只说「记录 + 解锁图鉴」，不许写「越用越准」：
         确认识别**不入特征库**（见云端 vision.confirm：只写 ai_samples 与图鉴），
         特征库不会因为用户点确认而变准，那样写是无依据的承诺。 -->
    <view class="card" wx:if="{{result.candidates.length && taskId}}">
      <view class="card-title">人工确认</view>
      <view class="small muted">
        你的确认会作为一条标注样本保存下来，并解锁这只猫的图鉴。
      </view>
      <view class="act-row mt">
        <block wx:if="{{!confirmedId}}">
          <view class="act-btn primary" bindtap="confirmTop" data-id="{{result.candidates[0].catId}}">
            就是「{{result.candidates[0].name}}」
          </view>
          <view class="act-btn ghost" bindtap="confirmNone">都不是</view>
        </block>
        <view class="act-btn ghost" wx:elif="{{confirmedId === 'none'}}">已记录：都不是</view>
        <view class="act-btn ghost" wx:else>已确认 ✓</view>
      </view>
    </view>

    <!-- 没匹配上（已经识别出特征，只是库里没有像的）。
         标题用花色而不是干巴巴的「档案库里没有它」：身份没认出来时，
         毛色/花纹是这次识别唯一有价值、且用户自己能校验的产出。
         ⚠️ 必须排除 qualityBlocked：那种情况是「照片看不清」而不是「库里没有」，
         两张卡同时出现会自相矛盾（一边说没匹配到、一边说没法比对）。 -->
    <view class="card" wx:if="{{!result.degraded && !result.candidates.length && !qualityBlocked}}">
      <view class="text-center" style="padding:20rpx 0">
        <view style="font-size:70rpx">🆕</view>
        <view class="bold mt">{{result.guessTitle}}</view>
        <view class="small muted" style="margin-top:12rpx;line-height:1.7">
          <!-- 「库是空的」和「库里没这只」是两件事：前者该等管理员建库，后者该建档 -->
          <block wx:if="{{result.indexedTotal === 0}}">
            特征库还没有建立，暂时没法做匹配。社团管理员完成建库后就能识别了。
          </block>
          <block wx:else>
            没能匹配到已有档案。这可能是还没登记的新猫，录入校园猫谱下次就能被认出来。
          </block>
        </view>
        <view class="small muted" style="margin-top:16rpx" wx:if="{{result.hasAttr}}">
          画面特征：{{result.attrText}}
        </view>
      </view>
    </view>

    <view class="act-row">
      <view class="act-btn ghost" bindtap="reset">重新识别</view>
      <view class="act-btn ghost" bindtap="goSighting">去打卡</view>
      <view class="act-btn primary" bindtap="goCreate">新建档案</view>
    </view>
  </block>

  <!-- 错误 -->
  <view class="card" wx:if="{{stage === 'done' && error}}">
    <view class="text-center" style="padding:30rpx 0">
      <view style="font-size:70rpx">⚠️</view>
      <view class="bold mt">识别失败</view>
      <view class="small muted" style="margin-top:12rpx">{{error}}</view>
      <view class="act-btn ghost mt" bindtap="reset">再试一次</view>
    </view>
  </view>

  <!-- 历史识别记录（仅保留最新 5 条，点击回看结果） -->
  <view class="card" wx:if="{{stage === 'idle' && history.length}}">
    <view class="card-title">
      历史识别记录
      <view class="more hist-clear" bindtap="clearHistory" hover-class="pressed">清空</view>
    </view>
    <view class="hist-item" wx:for="{{history}}" wx:key="ts" bindtap="tapHistory" data-index="{{index}}">
      <view class="hist-ico">{{item.mode === 'video' ? '🎬' : '📷'}}</view>
      <view class="hist-main">
        <view class="hist-title">
          <block wx:if="{{item.result.degraded}}">识别服务不可用</block>
          <block wx:elif="{{item.result.candidates.length}}">
            「{{item.result.candidates[0].name}}」{{item.result.candidates[0].score}}%
          </block>
          <block wx:else>未匹配到档案猫</block>
        </view>
        <view class="small muted">{{item.timeText}}</view>
      </view>
      <view class="hist-arrow">›</view>
    </view>
  </view>

</view>
