<view class="page">

  <!-- 非成员：引导申请 -->
  <view class="card" wx:if="{{!loading && !isMember}}">
    <view class="card-title">社团协作工作台</view>
    <view class="muted small" style="line-height:1.8">
      工作台是给校园动保社团使用的内部工具：TNR 台账、喂猫排班、资金收支、成员管理。
      确认身份后才能编辑猫档案。
    </view>
    <button class="btn mt" bindtap="goApply">申请加入社团</button>
    <view class="small muted mt" style="line-height:1.7">
      为什么需要审核？猫的精确位置、健康与医疗信息一旦公开，可能被别有用心的人利用。
      国内外都出现过流浪猫聚集点被虐猫者定位的案例，所以这类信息只对审核通过的志愿者开放。
    </view>
  </view>

  <block wx:if="{{isMember}}">
    <view class="card">
      <view class="card-title">待办概览</view>
      <view class="stat-grid">
        <view class="item">
          <view class="mini-stat">
            <view class="num">{{stats.pendingSighting}}</view>
            <view class="lbl">待建档目击</view>
          </view>
        </view>
        <view class="item">
          <view class="mini-stat">
            <view class="num">{{stats.todoTnr}}</view>
            <view class="lbl">待抓捕 TNR</view>
          </view>
        </view>
        <view class="item">
          <view class="mini-stat">
            <view class="num">{{stats.openTask}}</view>
            <view class="lbl">待认领任务</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">资金</view>
      <view class="flex-between">
        <view>
          <view class="small muted">当前结余</view>
          <view class="balance">¥ {{stats.balance}}</view>
        </view>
        <button class="btn btn-ghost btn-sm" data-url="/pages/fund/fund" bindtap="go">收支明细</button>
      </view>
    </view>

    <view class="entry-grid">
      <view class="entry" data-url="/pages/tnr/tnr" bindtap="go">
        <view class="entry-inner">
          <view class="ico">✂️</view>
          <view class="txt">TNR 台账</view>
          <view class="desc">抓捕 / 绝育 / 放归全流程</view>
        </view>
      </view>
      <view class="entry" data-url="/pages/task/task" bindtap="go">
        <view class="entry-inner">
          <view class="ico">📅</view>
          <view class="txt">喂猫排班</view>
          <view class="desc">任务发布与认领</view>
        </view>
      </view>
      <view class="entry" data-url="/pages/fund/fund" bindtap="go">
        <view class="entry-inner">
          <view class="ico">💰</view>
          <view class="txt">资金公示</view>
          <view class="desc">捐赠与支出透明化</view>
        </view>
      </view>
      <view class="entry" data-url="/pages/member/member" bindtap="go">
        <view class="entry-inner">
          <view class="ico">👥</view>
          <view class="txt">成员管理</view>
          <view class="desc">角色与入社审核</view>
        </view>
      </view>
      <view class="entry" data-url="/pages/cat-edit/cat-edit" bindtap="go">
        <view class="entry-inner">
          <view class="ico">🐱</view>
          <view class="txt">新建猫档案</view>
          <view class="desc">录入新发现的猫</view>
        </view>
      </view>
      <view class="entry" data-url="/pages/cats/cats?tab=sighting" bindtap="go">
        <view class="entry-inner">
          <view class="ico">📷</view>
          <view class="txt">目击审核</view>
          <view class="desc">认领 / 建档</view>
        </view>
      </view>
    </view>
  </block>

</view>
