.mini-stat {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}
.mini-stat .num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
}
.mini-stat .lbl {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.balance {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ok);
  margin-top: 6rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.entry {
  width: 50%;
  padding: 10rpx;
}
.entry-inner {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx 20rpx;
  text-align: center;
  height: 100%;
}
.entry-inner .ico { font-size: 46rpx; }
.entry-inner .txt {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 10rpx;
}
.entry-inner .desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}
