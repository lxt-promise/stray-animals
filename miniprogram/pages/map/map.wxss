.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
}
.map {
  width: 100%;
  height: 100%;
}
.map-top {
  position: absolute;
  top: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}
.map-hint {
  background: rgba(11, 17, 30, .92);
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  box-shadow: var(--shadow);
}
.locate-btn {
  position: absolute;
  right: 28rpx;
  top: 120rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--card);
  font-size: 40rpx;
  color: var(--brand);
  box-shadow: var(--shadow);
}
.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(120, 80, 40, .12);
  transition: transform .3s;
}
.bottom-sheet.collapsed { transform: translateY(calc(100% - 96rpx)); }
.sheet-handle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}
.handle-title { font-size: 30rpx; font-weight: 600; }
.handle-arrow { font-size: 24rpx; color: var(--text-sub); }
.sheet-list { max-height: 520rpx; padding: 0 24rpx 24rpx; }
.sheet-item {
  display: flex;
  align-items: center;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
}
.sheet-item.on { background: var(--brand-light); }
.sheet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 18rpx;
  overflow: hidden;
}
.sheet-avatar image { width: 100%; height: 100%; }
.sheet-info { flex: 1; }
.fab-small {
  position: absolute;
  right: 28rpx;
  bottom: 620rpx;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(249, 115, 22, .4);
}

/* ===== 点位说明（对齐预览：图例 + 坐标模糊化） ===== */
.legend-btn {
  position: absolute;
  right: 28rpx;
  top: 216rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--card);
  font-size: 36rpx;
  box-shadow: var(--shadow);
}
.legend-card {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 210rpx;
  padding: 28rpx;
  border-radius: var(--radius);
  background: rgba(255, 255, 255, .97);
  border: 2rpx solid var(--card-line);
  box-shadow: var(--shadow);
  z-index: 30;
}
.lg-title { font-size: 30rpx; margin-bottom: 20rpx; }
.lg-line { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 16rpx; }
.lg-note { line-height: 1.8; }
.lg-close { margin-top: 16rpx; text-align: right; }
